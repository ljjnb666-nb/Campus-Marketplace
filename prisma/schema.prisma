generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// REVOKED 仅能由中央 verification service 的显式 revoke 决策产生
// （Phase 6A：审核员吊销欺诈认证）；EXPIRED 语义留待未来有真实产生方时引入。
enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  REVOKED
}

enum ListingStatus {
  ACTIVE
  PAUSED
  SOLD
  RESERVED
  OFFLINE
}

enum ProductCondition {
  NEW
  LIKE_NEW
  LIGHTLY_USED
  NORMAL_USED
  HEAVILY_USED
}

enum ErrandTaskStatus {
  OPEN
  CLAIMED
  IN_PROGRESS
  PENDING_CONFIRMATION
  COMPLETED
  CANCELLED
  DISPUTED
  // Phase 8C-01：纠纷终局关闭（与 Order.CLOSED 成 canonical terminal pair）
  CLOSED
}

enum ServicePricingUnit {
  PER_SESSION
  PER_HOUR
  PER_ORDER
  NEGOTIABLE
}

enum OrderType {
  PRODUCT
  ERRAND
  SERVICE
}

enum OrderStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
  // Phase 8C-01：General OrderDispute lifecycle。
  // IN_DISPUTE = 订单暂时冻结在纠纷治理中（dispute 域是唯一出口）；
  // CLOSED = 经纠纷治理终局关闭（terminal；不复用 CANCELLED 伪装用户取消）。
  IN_DISPUTE
  CLOSED
}

// Phase 8C-01：General Order dispute lifecycle（语义与 RentalDisputeStatus
// 一致但保持独立 enum——General Order 不复用 RentalDispute 域类型）。
enum OrderDisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

// Phase 8B-01：PRODUCT PENDING reservation 的关闭原因（为什么 PENDING
// reservation 被关闭），不是通用 Order lifecycle 状态——EXPIRED 的业务
// 结果是 Order CANCELLED + 本 resolution，禁止新增 OrderStatus.EXPIRED。
enum ProductReservationResolution {
  ACCEPTED
  CANCELLED
  EXPIRED
}

// Phase 8D-01：General Order（PRODUCT / SERVICE）线下见面履约状态。
// 语义冻结：
//   PROPOSED          一方提出时间地点，尚未获得对方确认
//   CONFIRMED         另一方确认正式见面约定
//   COMPLETED         双方都完成 self-arrival confirmation（只表示双方已到场，
//                     绝不自动表示 Order.COMPLETED / Product.SOLD / 计数累加）
//   CANCELLED         本次 meetup 被取消（允许之后重新发起新 meetup）
//   NO_SHOW_REPORTED  一方在满足严格条件后报告另一方爽约（终局，本次 meetup
//                     不得重新打开）。NO_SHOW 只是 allegation / dispute
//                     trigger（与 OrderDispute 同事务原子创建），绝不是
//                     平台自动判责结果。
// 仅 CANCELLED 允许同一 Order 重新发起 meetup；PROPOSED/CONFIRMED/COMPLETED/
// NO_SHOW_REPORTED 为 active 集（DB partial unique 兜底唯一性）。
enum OrderMeetupStatus {
  PROPOSED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW_REPORTED
}

// Phase 8D-01（RB01）：meetup location snapshot 的 immutable 来源 provenance。
// MEETUP_POINT 恒不变——即使 MeetupPoint 之后被删除（meetupPointId 走
// ON DELETE SET NULL），历史快照的平台 catalog 来源语义绝不降级为 CUSTOM；
// erasure 依据本字段（而非可空的 meetupPointId）判定 user-authored custom
// location。DB CHECK 冻结 CUSTOM ⇒ meetupPointId IS NULL。
enum OrderMeetupLocationSource {
  CUSTOM
  MEETUP_POINT
}

enum PaymentStatus {
  UNPAID
  OFFLINE_PENDING
  PAID
  REFUNDED
}

enum MessageType {
  SYSTEM
  ORDER
  DIRECT
}

enum NotificationType {
  SYSTEM
  ORDER
  MESSAGE
  REVIEW
  REPORT
  RENTAL
}

enum ReportTargetType {
  PRODUCT
  ERRAND_TASK
  SERVICE_LISTING
  RENTAL_LISTING
  USER
  MESSAGE
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum ReportReason {
  FAKE_INFO
  SCAM_RISK
  BANNED_ITEM
  ACADEMIC_CHEATING
  HARASSMENT
  ADVERTISEMENT
  PRICE_FRAUD
  OTHER
}

enum ModerationTargetType {
  PRODUCT
  ERRAND
  SERVICE
  RENTAL
  MESSAGE
  GLOBAL
}

// ============================================================
// 对象存储资源模块枚举
// ============================================================

enum AssetAccess {
  PUBLIC
  PRIVATE
}

enum AssetCategory {
  AVATAR
  PRODUCT
  RENTAL
  SERVICE
  VERIFICATION
  HANDOVER
  RETURN
  REPORT
}

enum AssetStatus {
  UPLOADING // 预留事务已提交、S3 PUT 进行中（崩溃后由 cleanup 按 stale 回收）
  UPLOADED // S3 PUT 已确认，尚未绑定业务实体（超过 TTL 由 cleanup 回收）
  ATTACHED // 已绑定业务实体
  PENDING_DELETE // 已标记待删除（对象清理中/待重试）
  DELETED // 远端对象已删除，配额已释放（保留审计行）
}

model User {
  id                      String                    @id @default(cuid())
  name                    String
  email                   String                    @unique
  passwordHash            String
  avatarUrl               String?
  bio                     String?
  schoolName              String
  college                 String?
  grade                   String?
  studentIdLast4          String?
  phone                   String?
  // Phase 6A 起本字段不再作为授权依据（deprecated for authorization）：
  // 授权一律经中央 RBAC（UserRole → Role → RolePermission → Permission）判断；
  // 字段仅保留用于展示与迁移 bootstrap（migration/seed 会按 role=ADMIN
  // 同步授予 PLATFORM_ADMIN 角色）。禁止新增任何 `role === "ADMIN"` 业务判断。
  role                    UserRole                  @default(STUDENT)
  status                  UserStatus                @default(ACTIVE)
  verificationStatus      VerificationStatus        @default(UNVERIFIED)
  creditScore             Int                       @default(100)
  completedOrdersCount    Int                       @default(0)
  // Phase 8E：NON_AUTHORITATIVE_DERIVED_CACHE——公开好评率的 canonical
  // truth 是 visible 评价的 query-time 聚合（getPublishedGeneralReviewStats，
  // 见 src/lib/reviews/review-query.ts）。本缓存仅为兼容保留，任何
  // PUBLIC/USER_VISIBLE 读面禁止直接信任（blind/纠纷隐藏评价不得进入）。
  positiveReviewRate      Float                     @default(0)
  // 租赁统计字段
  rentalOwnerCount        Int                       @default(0)
  rentalRenterCount       Int                       @default(0)
  onTimeReturnRate        Float                     @default(0)
  // Phase 8E：NON_AUTHORITATIVE_DERIVED_CACHE——canonical truth 是
  // visible RentalReview 的 query-time 聚合（getPublishedRentalReviewStats）
  rentalPositiveRate      Float                     @default(0)
  rentalDisputeCount      Int                       @default(0)
  // 上传存储配额：已占用字节数（含 PENDING_DELETE 待回收部分）。
  // 预留/释放走条件原子 UPDATE，见 src/lib/asset-service.ts
  storageUsedBytes        Int                       @default(0)
  lastLoginAt             DateTime?
  campusId                String
  campus                  Campus                    @relation(fields: [campusId], references: [id])
  accounts                Account[]
  sessions                Session[]
  verification            UserVerification?
  products                Product[]
  favoriteProducts        Favorite[]
  errandFavorites         ErrandFavorite[]
  serviceFavorites        ServiceFavorite[]
  createdErrandTasks      ErrandTask[]              @relation("ErrandTaskPublisher")
  acceptedErrandTasks     ErrandTask[]              @relation("ErrandTaskAccepter")
  serviceListings         ServiceListing[]
  buyerOrders             Order[]                   @relation("OrderBuyer")
  sellerOrders            Order[]                   @relation("OrderSeller")
  sentMessages            Message[]                 @relation("MessageSender")
  conversationLinks       ConversationParticipant[]
  writtenReviews          Review[]                  @relation("ReviewAuthor")
  receivedReviews         Review[]                  @relation("ReviewTarget")
  reports                 Report[]                  @relation("ReportReporter")
  receivedReports         Report[]                  @relation("ReportTargetUser")
  notifications           Notification[]
  blockedUsers            BlockedUser[]             @relation("BlockedByUser")
  blockedByUsers          BlockedUser[]             @relation("BlockedTargetUser")
  adminLogs               AdminLog[]                @relation("AdminActor")
  uploadedAssets          UploadedAsset[]           @relation("AssetOwner")
  // 租赁关联
  rentalListings          RentalListing[]           @relation("RentalOwner")
  rentalOrdersAsOwner     RentalOrder[]             @relation("RentalOrderOwner")
  rentalOrdersAsRenter    RentalOrder[]             @relation("RentalOrderRenter")
  rentalReviewsGiven      RentalReview[]            @relation("RentalReviewAuthor")
  rentalReviewsReceived   RentalReview[]            @relation("RentalReviewTarget")
  rentalFavorites         RentalFavorite[]
  policyAcceptances       PolicyAcceptance[]
  privacyRequests         PrivacyRequest[]
  // Phase 9C-03：本人隐私导出 artifact（derived ephemeral，短 TTL，
  // 不计入 storageUsedBytes）
  dataExportArtifacts     DataExportArtifact[]
  // Phase 6A：身份 / RBAC 关联
  memberships             CampusMembership[]
  userRoles               UserRoleAssignment[]
  reviewedVerifications   UserVerification[]        @relation("VerificationReviewer")
  // Phase 6B：trust / risk / enforcement 关联
  riskStates              RiskState[]
  riskFlags               RiskFlag[]
  enforcementAsActor      EnforcementAction[]       @relation("EnforcementActor")
  enforcementAsTarget     EnforcementAction[]       @relation("EnforcementTarget")
  // Phase 6C-1B：本用户作为 terminal decision reviewer 的申诉记录
  reviewedAppeals         Appeal[]                  @relation("AppealReviewer")
  // Phase 7C：listing 治理 overlay（provenance，Restrict：历史不可随账户删除丢失）
  listingModerations      ListingModeration[]       @relation("ListingModerator")
  listingRestorations     ListingModeration[]       @relation("ListingModerationResolver")
  // Phase 7E：举报运营 case 领用（claim/release；SetNull：领用人引用消失时 case 仍在）
  assignedModerationCases ModerationCase[]          @relation("ModerationCaseAssignee")
  // Phase 8C-01：General OrderDispute（initiator / 运营领用 SetNull 同上）
  initiatedOrderDisputes  OrderDispute[]            @relation("OrderDisputeInitiator")
  assignedOrderDisputes   OrderDispute[]            @relation("OrderDisputeAssignee")
  // Phase 8D-01：General Order meetup。proposedById 是 custom location 快照
  // 的唯一作者归属（erasure 依据）；全部 participant actor FK Restrict——
  // meetup 是交易 provenance，不随账户行删除丢失（账户走 pseudonymous erasure）。
  proposedOrderMeetups    OrderMeetup[]             @relation("OrderMeetupProposer")
  confirmedOrderMeetups   OrderMeetup[]             @relation("OrderMeetupConfirmer")
  cancelledOrderMeetups   OrderMeetup[]             @relation("OrderMeetupCanceller")
  noShowReportedMeetups   OrderMeetup[]             @relation("OrderMeetupNoShowReporter")
  noShowTargetedMeetups   OrderMeetup[]             @relation("OrderMeetupNoShowTarget")
  // Phase 7G：dispute / support 运营领用（claim/release；SetNull 同上）
  assignedDisputes        RentalDispute[]           @relation("DisputeAssignee")
  assignedSupportTickets  SupportTicket[]           @relation("SupportTicketAssignee")
  supportTickets          SupportTicket[]           @relation("SupportTicketRequester")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  deletedAt               DateTime?
  // 账号注销完成时间。与 deletedAt 互斥使用：注销保留行（pseudonymous id
  // 维持订单/评价/举报等历史引用），仅匿名化个人字段并吊销认证。
  erasedAt                DateTime?

  @@index([campusId, role])
  @@index([verificationStatus, status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Campus {
  id                   String                     @id @default(cuid())
  name                 String
  slug                 String                     @unique
  schoolName           String
  district             String?
  isActive             Boolean                    @default(true)
  users                User[]
  products             Product[]
  errandTasks          ErrandTask[]
  serviceListings      ServiceListing[]
  rentalListings       RentalListing[]
  // Phase 6A：Campus 为一等领域实体（租户/校园边界）
  memberships          CampusMembership[]
  verificationPolicies CampusVerificationPolicy[]
  userRoles            UserRoleAssignment[]
  adminLogs            AdminLog[]
  runtimeConfigOverrides RuntimeConfigOverride[]
  featureFlagOverrides FeatureFlagOverride[]
  // Phase 6B：trust / risk / enforcement
  riskStates           RiskState[]
  riskFlags            RiskFlag[]
  enforcementActions   EnforcementAction[]
  // Phase 7C：listing 治理 overlay
  listingModerations   ListingModeration[]
  // Phase 7E：举报 scope 快照与运营 case（Restrict：治理 provenance 不随删除丢失）
  reportedScope        Report[]                   @relation("ReportScopeCampus")
  moderationCases      ModerationCase[]           @relation("ModerationCaseCampus")
  // Phase 7G：dispute / support scope 快照（Restrict 同上）
  rentalDisputes       RentalDispute[]            @relation("RentalDisputeScopeCampus")
  // Phase 8C-01：General OrderDispute scope 快照（Restrict 同上）
  orderDisputes        OrderDispute[]             @relation("OrderDisputeScopeCampus")
  supportTickets       SupportTicket[]            @relation("SupportTicketScopeCampus")
  // Phase 8D-01：meetup campus 权威快照（Restrict 同上）+ 见面点 catalog
  meetupPoints         MeetupPoint[]              @relation("MeetupPointCampus")
  orderMeetups         OrderMeetup[]              @relation("OrderMeetupCampus")
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
}

// 校园成员认证记录（Phase 6A 演进：挂在 CampusMembership 上，而非全局 user）。
// 状态机：UNVERIFIED→PENDING→VERIFIED/REJECTED；REJECTED/REVOKED/VERIFIED→PENDING（重新提交）；
// VERIFIED→REVOKED（审核员吊销）。所有状态流转必须经
// src/lib/campus/verification-service.ts 的中央 transition service，禁止原地任意赋值。
// @@unique([userId]) 为当前产品"单 active campus"现状的表达；多校区展开时随
// CampusMembership 一并演进。历史迁移行 policy 三元组为 null（迁移前无 policy 机制，
// 保留 null 即真实证据，不伪造历史认证依据）。
model UserVerification {
  id               String                    @id @default(cuid())
  userId           String                    @unique
  membershipId     String                    @unique
  schoolName       String
  campusName       String
  studentIdLast4   String
  studentCardImage String
  status           VerificationStatus        @default(PENDING)
  reviewNote       String?
  // 审核决策机器可读原因码（如 VERIFICATION_MATERIALS_INVALID），可空
  reasonCode       String?
  submittedAt      DateTime                  @default(now())
  // Phase 7F 审核SLA：提交/重新提交时 = submittedAt + 48h（唯一运行时写路径；
  // 历史行由 migration backfill 以 submittedAt 为 origin，绝不用迁移执行时刻）。
  // 决定后保留为历史值；OVERDUE 只读判定 = PENDING ∧ reviewDueAt < now，
  // 不驱动任何自动决定或 enforcement。
  reviewDueAt      DateTime
  reviewedAt       DateTime?
  reviewedById     String?
  // 认证证据必须能反查其依据的 policy/version（发布后不可变，冗余快照三元组，
  // 与 PolicyAcceptance 同一工程原则）；迁移旧行为 null = 当时不存在 policy 机制
  policyId         String?
  policyVersion    Int?
  policyHash       String?
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership       CampusMembership          @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  reviewedBy       User?                     @relation("VerificationReviewer", fields: [reviewedById], references: [id])
  policy           CampusVerificationPolicy? @relation(fields: [policyId], references: [id])
  uploadedAssets   UploadedAsset[]           @relation("AssetVerification")

  // Phase 7F：治理队列排序（reviewDueAt ASC, submittedAt ASC, id ASC）
  @@index([reviewDueAt, submittedAt, id])
}

model ProductCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ErrandCategory {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  errandTasks ErrandTask[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ServiceCategory {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  sortOrder       Int              @default(0)
  isActive        Boolean          @default(true)
  serviceListings ServiceListing[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Product {
  id             String           @id @default(cuid())
  title          String
  description    String           @db.Text
  price          Decimal          @db.Decimal(10, 2)
  originalPrice  Decimal?         @db.Decimal(10, 2)
  locationText   String
  condition      ProductCondition
  status         ListingStatus    @default(ACTIVE)
  viewCount      Int              @default(0)
  favoriteCount  Int              @default(0)
  sellerId       String
  seller         User             @relation(fields: [sellerId], references: [id])
  campusId       String
  campus         Campus           @relation(fields: [campusId], references: [id])
  categoryId     String
  category       ProductCategory  @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  favorites      Favorite[]
  orders         Order[]
  conversations  Conversation[]
  reports        Report[]         @relation("ReportTargetProduct")
  uploadedAssets UploadedAsset[]  @relation("AssetProduct")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  // Phase 7C：治理 overlay（活跃行 = 隐藏中；业务 status 零变更）
  moderations ListingModeration[] @relation("ModerationTargetProduct")

  // FINAL REPAIR A（LR-013/LR-012）：高频排序/检索 query-shape 索引。
  // 逐条形状与 EXPLAIN 证据见 migration 20260926100802；软删谓词不作
  // partial 条件（查询侧恒为字面量，~2% recheck 换取 datamodel 可表达，
  // 保持 drift=NONE 不变量）。
  @@index([campusId, status, createdAt])
  @@index([sellerId, status])
  @@index([categoryId, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([favoriteCount(sort: Desc), viewCount(sort: Desc), createdAt(sort: Desc)])
  @@index([price, favoriteCount(sort: Desc), createdAt(sort: Desc)], map: "Product_budget_idx")
  @@index([price(sort: Desc), favoriteCount(sort: Desc), createdAt(sort: Desc)], map: "Product_price_desc_idx")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model RentalFavorite {
  id              String        @id @default(cuid())
  userId          String
  rentalListingId String
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rentalListing   RentalListing @relation(fields: [rentalListingId], references: [id], onDelete: Cascade)

  @@unique([userId, rentalListingId])
  @@index([rentalListingId])
}

model ErrandFavorite {
  id           String     @id @default(cuid())
  userId       String
  errandTaskId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  errandTask   ErrandTask @relation(fields: [errandTaskId], references: [id], onDelete: Cascade)

  @@unique([userId, errandTaskId])
  @@index([errandTaskId])
}

model ServiceFavorite {
  id               String         @id @default(cuid())
  userId           String
  serviceListingId String
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceListing   ServiceListing @relation(fields: [serviceListingId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceListingId])
  @@index([serviceListingId])
}

model ErrandTask {
  id               String           @id @default(cuid())
  title            String
  description      String           @db.Text
  categoryId       String
  category         ErrandCategory   @relation(fields: [categoryId], references: [id])
  reward           Decimal          @db.Decimal(10, 2)
  pickupLocation   String
  deliveryLocation String
  contactNote      String?
  deadline         DateTime
  needsAdvancePay  Boolean          @default(false)
  advanceAmount    Decimal?         @db.Decimal(10, 2)
  status           ErrandTaskStatus @default(OPEN)
  publisherId      String
  publisher        User             @relation("ErrandTaskPublisher", fields: [publisherId], references: [id])
  accepterId       String?
  accepter         User?            @relation("ErrandTaskAccepter", fields: [accepterId], references: [id])
  campusId         String
  campus           Campus           @relation(fields: [campusId], references: [id])
  orders           Order[]
  conversations    Conversation[]
  reports          Report[]         @relation("ReportTargetErrand")
  favorites        ErrandFavorite[]
  favoriteCount    Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  // Phase 7C：治理 overlay（活跃行 = 隐藏中；workflow 状态零变更）
  moderations ListingModeration[] @relation("ModerationTargetErrand")

  // FINAL REPAIR A：homepage 跑腿两榜（deadline/reward 交叉序）+ 默认序检索游走
  @@index([campusId, status, deadline])
  @@index([publisherId, status])
  @@index([categoryId, status])
  @@index([status, deadline, reward(sort: Desc)])
  @@index([status, reward(sort: Desc), deadline])
  @@index([createdAt(sort: Desc)])
}

model ServiceListing {
  id                  String             @id @default(cuid())
  title               String
  description         String             @db.Text
  coverImageUrl       String?
  categoryId          String
  category            ServiceCategory    @relation(fields: [categoryId], references: [id])
  price               Decimal            @db.Decimal(10, 2)
  pricingUnit         ServicePricingUnit
  locationText        String
  availableSchedule   String?
  status              ListingStatus      @default(ACTIVE)
  completedOrderCount Int                @default(0)
  averageRating       Float              @default(0)
  providerId          String
  provider            User               @relation(fields: [providerId], references: [id])
  campusId            String
  campus              Campus             @relation(fields: [campusId], references: [id])
  orders              Order[]
  conversations       Conversation[]
  reports             Report[]           @relation("ReportTargetService")
  uploadedAssets      UploadedAsset[]    @relation("AssetServiceListing")
  favorites           ServiceFavorite[]
  favoriteCount       Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  // Phase 7C：治理 overlay（活跃行 = 隐藏中；业务 status 零变更）
  moderations ListingModeration[] @relation("ModerationTargetService")

  // FINAL REPAIR A：homepage 服务两榜 + orders_desc 页排序 + 默认序检索游走
  @@index([campusId, status, createdAt])
  @@index([providerId, status])
  @@index([categoryId, status])
  @@index([completedOrderCount(sort: Desc), createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model Order {
  id               String          @id @default(cuid())
  orderNo          String          @unique
  type             OrderType
  status           OrderStatus     @default(PENDING)
  paymentStatus    PaymentStatus   @default(UNPAID)
  amount           Decimal         @db.Decimal(10, 2)
  // Phase 8D-01 权威状态冻结：本字段只是下单时的初始见面偏好快照
  // （buyer-authored），绝不是正式见面约定 authority。正式约定 = OrderMeetup
  // （locationTextSnapshot / scheduledAt / status / arrival fields）。
  meetingLocation  String?
  note             String?
  cancelReason     String?
  completedAt      DateTime?
  buyerId          String
  buyer            User            @relation("OrderBuyer", fields: [buyerId], references: [id])
  sellerId         String
  seller           User            @relation("OrderSeller", fields: [sellerId], references: [id])
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id])
  errandTaskId     String?
  errandTask       ErrandTask?     @relation(fields: [errandTaskId], references: [id])
  serviceListingId String?
  serviceListing   ServiceListing? @relation(fields: [serviceListingId], references: [id])
  reviews          Review[]
  notifications    Notification[]
  conversations    Conversation[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Phase 8B-01：PRODUCT PENDING reservation deadline（seller 确认截止）。
  // 仅 type=PRODUCT 拥有：非 PRODUCT 三字段恒 NULL；accept/cancel/expire
  // 写入 (resolvedAt, resolution) 二元组；EXPIRED = 超时系统关闭。
  productReservationExpiresAt  DateTime?
  productReservationResolvedAt DateTime?
  productReservationResolution ProductReservationResolution?

  // Phase 8C-01：General OrderDispute（独立于 RentalDispute 的交易纠纷域）
  orderDisputes OrderDispute[] @relation("OrderDisputeOrder")

  // Phase 8D-01：线下见面履约（正式见面约定 authority；历史 CANCELLED
  // meetup 保留，active meetup 同期至多一个——DB partial unique 兜底）
  meetups OrderMeetup[] @relation("OrderMeetupOrder")

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([type, status])
  // Phase 9 scheduler 发现 PRODUCT PENDING expiresAt <= now 的预留扫描索引
  @@index([type, status, productReservationExpiresAt])
}

model Conversation {
  id               String                    @id @default(cuid())
  title            String?
  conversationKey  String?                   @unique
  productId        String?
  errandTaskId     String?
  serviceListingId String?
  rentalListingId  String?
  orderId          String?
  rentalOrderId    String?
  product          Product?                  @relation(fields: [productId], references: [id])
  errandTask       ErrandTask?               @relation(fields: [errandTaskId], references: [id])
  serviceListing   ServiceListing?           @relation(fields: [serviceListingId], references: [id])
  rentalListing    RentalListing?            @relation(fields: [rentalListingId], references: [id])
  order            Order?                    @relation(fields: [orderId], references: [id])
  rentalOrder      RentalOrder?              @relation(fields: [rentalOrderId], references: [id])
  participants     ConversationParticipant[]
  messages         Message[]
