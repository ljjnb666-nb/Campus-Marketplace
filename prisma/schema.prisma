model Review {
  id           String    @id @default(cuid())
  orderId      String
  authorId     String
  targetUserId String
  rating       Int
  content      String?
  tags         String[]
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author       User      @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetUser   User      @relation("ReviewTarget", fields: [targetUserId], references: [id])
  createdAt    DateTime  @default(now())
  // Phase 8E Review Integrity：双盲发布 metadata（canonical visibility 见
  // src/lib/reviews/review-integrity.ts——publishedAt != null OR blindUntil <= now
  // 是 publication 条件，完整公开条件还包括 Order COMPLETED + 无 active dispute）。
  // blindUntil = 本订单统一 reviewDeadline（completedAt + REVIEW_WINDOW）；
  // publishedAt = 双方均提交时的提前公开时间。评价一经提交 immutable（§31），
  // visibility 与存在性是两个概念——禁止删除/改写评价行。
  blindUntil   DateTime
  publishedAt  DateTime?

  @@unique([orderId, authorId])
  @@index([targetUserId, createdAt])
}

model Report {
  id               String           @id @default(cuid())
  targetType       ReportTargetType
  reason           ReportReason
  detail           String?
  status           ReportStatus     @default(OPEN)
  reporterId       String
  targetUserId     String?
  productId        String?
  errandTaskId     String?
  serviceListingId String?
  rentalListingId  String?
  messageId        String?
  handledById      String?
  handledNote      String?
  handledAt        DateTime?
  // Phase 7E：immutable scope provenance（创建时快照，绝不回填猜测）。
  // 四类 listing 目标 = 目标对象 campusId + scopeKey=CAMPUS:<campusId>；
  // USER/MESSAGE = campusId null + scopeKey=UNSCOPED（frozen fail-closed rule）。
  campusId         String?
  scopeKey         String
  reporter         User             @relation("ReportReporter", fields: [reporterId], references: [id])
  targetUser       User?            @relation("ReportTargetUser", fields: [targetUserId], references: [id])
  product          Product?         @relation("ReportTargetProduct", fields: [productId], references: [id])
  errandTask       ErrandTask?      @relation("ReportTargetErrand", fields: [errandTaskId], references: [id])
  serviceListing   ServiceListing?  @relation("ReportTargetService", fields: [serviceListingId], references: [id])
  rentalListing    RentalListing?   @relation("ReportTargetRental", fields: [rentalListingId], references: [id])
  message          Message?         @relation("ReportTargetMessage", fields: [messageId], references: [id])
  campus           Campus?          @relation("ReportScopeCampus", fields: [campusId], references: [id], onDelete: Restrict)
  moderationCase   ModerationCase?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  // Phase 7E：campus reviewer 的 exact-pair 授权谓词（campusId ∧ scopeKey
  // 同源合取；禁止 campusId IN (...) 叉积语义依赖本索引之外的查询形状）。
  @@index([campusId, scopeKey])
}

// Phase 7E：举报运营 case（1:1 Report）。Report 仍是 canonical decision truth
// ——本表只承载运营元数据（assignment / SLA dueAt / 关闭时钟），零 decision
// state（终局结果唯一权威是 Report.status）。case operational state 由
// closedAt 派生：null = ACTIVE，非 null = CLOSED。
model ModerationCase {
  id             String    @id @default(cuid())
  reportId       String    @unique
  campusId       String?
  scopeKey       String
  assignedToId   String?
  openedAt       DateTime
  dueAt          DateTime
  lastActivityAt DateTime
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  report     Report  @relation(fields: [reportId], references: [id], onDelete: Restrict)
  campus     Campus? @relation("ModerationCaseCampus", fields: [campusId], references: [id], onDelete: Restrict)
  assignedTo User?   @relation("ModerationCaseAssignee", fields: [assignedToId], references: [id])

  // 队列排序 keyset tuple（dueAt ASC, createdAt ASC, id ASC）
  @@index([dueAt, createdAt, id])
  // campus reviewer exact-pair 授权谓词
  @@index([campusId, scopeKey])
  @@index([assignedToId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  orderId   String?
  type      NotificationType
  title     String
  content   String
  isRead    Boolean          @default(false)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())

  // Phase 9A：outbox-driven In-App 通知的 exactly-once 身份。
  // dedupeKey = OUTBOX:<eventId>:IN_APP:<userId>（DB 级幂等唯一键；
  // PostgreSQL unique index 允许多行 NULL——历史同步通知 dedupeKey 为 NULL，
  // 行为完全兼容）。sourceEventId = 产生本通知的 OutboxEvent.id（溯源）。
  dedupeKey     String? @unique
  sourceEventId String?

  // Phase 9B：canonical notification identity（kind/version registry）。
  // 三列原子 NULL 或原子 NOT NULL（DB CHECK 强制，禁止半迁移状态）：
  // - 历史（9B 前）同步通知保持三列 NULL，禁止按 title 猜测回填；
  // - 9B 起所有 production 通知由 canonical service 写入，kind !=
  //   null 且 schemaVersion != null 且 payload != null 且 dedupeKey != null。
  // payload 只允许 IDs + 机器状态（zod strict 契约在写边界强制），
  // 禁止 user-authored 自由文本 / secret / provider raw payload。
  kind          String?
  schemaVersion Int?
  payload       Json?

  @@index([userId, isRead, createdAt])
}

// Phase 9B：canonical channel delivery provenance（EMAIL 等 external channel）。
//
// 定位（§12）：本表只保存 channel delivery provenance——retry / lease /
// attempts / backoff authority 全部属于 Phase 9A AsyncJob
// （NOTIFICATION_DELIVERY:<deliveryId>），禁止在本表复制第二套状态机。
//
// 关系（契约，非 Prisma relation）：Notification 1 → many NotificationDelivery，
// 通过裸 notificationId 列关联。刻意不建 FK relation：账号注销按 RB-23
// 整表删除 Notification（derived ephemeral inbox），而 delivery 行必须
// 存活以表达 RECIPIENT_ERASED 抑制语义（§35：注销时 unsent EMAIL delivery
// 置 suppressedAt/suppressionCode 并清空 destination，重放 job 见 suppressed
// → 0 次 provider call 幂等完成）。erasure 事务保证先抑制 delivery、后删除
// notification（同事务原子），应用层是唯一写入方（canonical emit service）。
//
// 语义（§28）：providerAcceptedAt = provider 接受发送请求；绝不声称
// mailbox delivered / opened / read。9B 不做 delivery webhook。
// destination = CONTACT_INFO（DIRECT_IDENTITY，privacy registry 登记），
// 绝不进入结构化日志；erasure 时按 RECIPIENT_ERASED / retention 收敛。
model NotificationDelivery {
  id                     String  @id @default(cuid())
  notificationId         String
  // channel 是 String（不用 Prisma enum，与 job kind 同哲学）：9B 实现
  // IN_APP（无 external delivery row）/ EMAIL；未来 WEB_PUSH / EXTERNAL
  // channel 可扩展，不得为未实现渠道预建 provider。
  channel                String
  // provider 快照 = emit 时刻解析的投递渠道实现（如 resend / disabled）。
  provider               String
  // 收件目的地快照（EMAIL = 收件邮箱）：emit 时刻快照，retry 绝不重读
  // User.email——payload 在 retry 间必须 deterministic（§33）。
  destination            String
  senderSnapshot         String
  replyToSnapshot        String?
  // provider 幂等键（deterministic：notification/<id>/email/v1），
  // 绝不允许每次 retry 生成随机 UUID。
  providerIdempotencyKey String  @unique
  providerMessageId      String?

  // 首次实际 provider attempt 时刻（provider 24h 幂等保留窗口的本地
  // 安全基准；EMAIL_IDEMPOTENCY_SAFE_WINDOW = 23h，超窗 fail closed）。
  firstAttemptAt     DateTime?
  providerAcceptedAt DateTime?
  suppressedAt       DateTime?
  suppressionCode    String?

  // Phase 9C-04：PII retention（§16/§17）。destination 是收件邮箱快照
  //（DIRECT_IDENTITY / CONTACT_INFO）——terminal（providerAcceptedAt 或
  // suppressedAt 非空）超过 retention cutoff 后自动收敛为
  // REDACTED_EMAIL_DESTINATION 哨兵并落 redactedAt：PII 消失，delivery
  // provenance（provider / 幂等键 / message id / 时间戳 / 抑制码）保留。
  // pending（两列皆空）的行绝不被 retention 触碰——worker 仍需要
  // destination 发送（§18）；erasure 路径的 immediate redaction 同步设置
  // 本列（§19，erasure race authority 不变）。
  redactedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 每个通知的每个渠道至多一条 delivery（重复 canonical emit → 复用）。
  @@unique([notificationId, channel])
  @@index([notificationId])
  // ops/observability seam：按渠道扫描 suppressed / accepted 状态
  @@index([channel, suppressedAt])
  @@index([channel, providerAcceptedAt])
  // Phase 9C-04：PII retention candidate 扫描（terminal + redactedAt IS NULL，
  // §45）——避免 retention 周期全表扫
  @@index([providerAcceptedAt, redactedAt])
  @@index([suppressedAt, redactedAt])
}

model BlockedUser {
  id            String   @id @default(cuid())
  blockerId     String
  blockedUserId String
  reason        String?
  createdAt     DateTime @default(now())
  blocker       User     @relation("BlockedByUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUser   User     @relation("BlockedTargetUser", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
}

model ModerationKeyword {
  id          String               @id @default(cuid())
  keyword     String               @unique
  targetType  ModerationTargetType @default(GLOBAL)
  isEnabled   Boolean              @default(true)
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

// 管理审计日志（Phase 6A AdminAuditLog foundation，演进自既有 AdminLog）。
// append-only：业务层不提供任何 update/delete 入口；metadata 仅接受
// admin-audit 服务白名单键，禁止出现凭据/完整学号/私有对象键/私有 URL。

// Phase 10E: ONLY typed, non-secret, server-owned runtime configuration.
// Config write authority and scope safety are enforced by the service and DB.
// Revision rows are immutable provenance, independent from mutable current state.

/**
 * Phase 10F: restrictive feature flags. An explicit local false never bypasses
 * a true GLOBAL disable; null is a versioned INHERIT marker, not deletion.
 */
model FeatureFlagOverride {
  id         String   @id @default(cuid())
  key        String
  scopeKey   String
  campusId   String?
  disabled   Boolean?
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  campus     Campus?  @relation(fields: [campusId], references: [id], onDelete: Restrict)
  revisions  FeatureFlagRevision[]

  @@unique([key, scopeKey])
  @@index([campusId, key])
}

model FeatureFlagRevision {
  id               String   @id @default(cuid())
  flagId           String
  version          Int
  previousDisabled Boolean?
  nextDisabled     Boolean?
  createdAt        DateTime @default(now())
  flag             FeatureFlagOverride @relation(fields: [flagId], references: [id], onDelete: Restrict)

  @@unique([flagId, version])
  @@index([flagId, createdAt])
}

model RuntimeConfigOverride {
  id          String   @id @default(cuid())
  key         String
  scopeKey    String
  campusId    String?
  value       Int?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  campus      Campus?  @relation(fields: [campusId], references: [id], onDelete: Restrict)
  revisions   RuntimeConfigRevision[]

  @@unique([key, scopeKey])
  @@index([campusId, key])
}

model RuntimeConfigRevision {
  id            String   @id @default(cuid())
  configId      String
  version       Int
  previousValue Int?
  newValue      Int?
  createdAt     DateTime @default(now())
  config        RuntimeConfigOverride @relation(fields: [configId], references: [id], onDelete: Restrict)

  @@unique([configId, version])
  @@index([configId, createdAt])
}

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  detail     String?
  // campus-scoped 操作的目标校区（可空 = 全局操作）
  campusId   String?
  // 机器可读执行结果（6A 全部写入路径为 SUCCESS；失败尝试仅记结构化日志）
  result     String   @default("SUCCESS")
  // 白名单结构化元数据（经 recordAdminAudit 过滤），可空
  metadata   Json?
  createdAt  DateTime @default(now())
  admin      User     @relation("AdminActor", fields: [adminId], references: [id], onDelete: Cascade)
  campus     Campus?  @relation(fields: [campusId], references: [id])

  @@index([adminId, createdAt])
  @@index([targetType, targetId, createdAt])
  // Phase 7D 审计可见性：仅为 /governance/audit 可见性/过滤查询优化执行，
  // 不定义任何 scope 语义（授权谓词独立于索引存在）。
  @@index([campusId, createdAt, id])
  @@index([createdAt, id])
}

// ============================================================
// 对象存储资源模型
// ============================================================

// 统一资源登记表：所有上传文件（公私）都以此表为可信记录，
// 业务表中的图片字段只存展示 URL（公开）或 asset:<id> 引用（私有）。
model UploadedAsset {
  id               String        @id @default(cuid())
  ownerId          String
  category         AssetCategory
  access           AssetAccess
  bucket           String // 写入时使用的 bucket 名（冗余存储，防 bucket 配置漂移）
  objectKey        String        @unique
  mimeType         String
  sizeBytes        Int // 重编码后实际存储大小
  width            Int?
  height           Int?
  originalFileName String? // 仅审计用途，绝不参与 object key 生成
  status           AssetStatus   @default(UPLOADED)
  // 业务绑定（上传时未知实体，attach 时回填；实体物理删除时置空）
  productId        String?
  rentalListingId  String?
  serviceListingId String?
  rentalOrderId    String?
  verificationId   String?
  attachedAt       DateTime?
  // 敏感资产保留期截止（如学生证材料），到期由 cleanup 删除对象但保留认证结论
  expiresAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  owner          User              @relation("AssetOwner", fields: [ownerId], references: [id])
  product        Product?          @relation("AssetProduct", fields: [productId], references: [id], onDelete: SetNull)
  rentalListing  RentalListing?    @relation("AssetRentalListing", fields: [rentalListingId], references: [id], onDelete: SetNull)
  serviceListing ServiceListing?   @relation("AssetServiceListing", fields: [serviceListingId], references: [id], onDelete: SetNull)
  rentalOrder    RentalOrder?      @relation("AssetRentalOrder", fields: [rentalOrderId], references: [id], onDelete: SetNull)
  verification   UserVerification? @relation("AssetVerification", fields: [verificationId], references: [id], onDelete: SetNull)

  @@index([ownerId, status])
  @@index([status, createdAt])
  @@index([expiresAt, status])
  @@index([productId])
  @@index([rentalListingId])
  @@index([serviceListingId])
  @@index([rentalOrderId])
}

