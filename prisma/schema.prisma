generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// REVOKED 仅能由中央 verification service 的显式 revoke 决策产生
// （Phase 6A：审核员吊销欺诈认证）；EXPIRED 语义留待未来有真实产生方时引入。
enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  REVOKED
}

enum ListingStatus {
  ACTIVE
  PAUSED
  SOLD
  RESERVED
  OFFLINE
}

enum ProductCondition {
  NEW
  LIKE_NEW
  LIGHTLY_USED
  NORMAL_USED
  HEAVILY_USED
}

enum ErrandTaskStatus {
  OPEN
  CLAIMED
  IN_PROGRESS
  PENDING_CONFIRMATION
  COMPLETED
  CANCELLED
  DISPUTED
}

enum ServicePricingUnit {
  PER_SESSION
  PER_HOUR
  PER_ORDER
  NEGOTIABLE
}

enum OrderType {
  PRODUCT
  ERRAND
  SERVICE
}

enum OrderStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  OFFLINE_PENDING
  PAID
  REFUNDED
}

enum MessageType {
  SYSTEM
  ORDER
  DIRECT
}

enum NotificationType {
  SYSTEM
  ORDER
  MESSAGE
  REVIEW
  REPORT
  RENTAL
}

enum ReportTargetType {
  PRODUCT
  ERRAND_TASK
  SERVICE_LISTING
  RENTAL_LISTING
  USER
  MESSAGE
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum ReportReason {
  FAKE_INFO
  SCAM_RISK
  BANNED_ITEM
  ACADEMIC_CHEATING
  HARASSMENT
  ADVERTISEMENT
  PRICE_FRAUD
  OTHER
}

enum ModerationTargetType {
  PRODUCT
  ERRAND
  SERVICE
  RENTAL
  MESSAGE
  GLOBAL
}

// ============================================================
// 对象存储资源模块枚举
// ============================================================

enum AssetAccess {
  PUBLIC
  PRIVATE
}

enum AssetCategory {
  AVATAR
  PRODUCT
  RENTAL
  SERVICE
  VERIFICATION
  HANDOVER
  RETURN
  REPORT
}

enum AssetStatus {
  UPLOADING // 预留事务已提交、S3 PUT 进行中（崩溃后由 cleanup 按 stale 回收）
  UPLOADED // S3 PUT 已确认，尚未绑定业务实体（超过 TTL 由 cleanup 回收）
  ATTACHED // 已绑定业务实体
  PENDING_DELETE // 已标记待删除（对象清理中/待重试）
  DELETED // 远端对象已删除，配额已释放（保留审计行）
}

model User {
  id                    String                    @id @default(cuid())
  name                  String
  email                 String                    @unique
  passwordHash          String
  avatarUrl             String?
  bio                   String?
  schoolName            String
  college               String?
  grade                 String?
  studentIdLast4        String?
  phone                 String?
  // Phase 6A 起本字段不再作为授权依据（deprecated for authorization）：
  // 授权一律经中央 RBAC（UserRole → Role → RolePermission → Permission）判断；
  // 字段仅保留用于展示与迁移 bootstrap（migration/seed 会按 role=ADMIN
  // 同步授予 PLATFORM_ADMIN 角色）。禁止新增任何 `role === "ADMIN"` 业务判断。
  role                  UserRole                  @default(STUDENT)
  status                UserStatus                @default(ACTIVE)
  verificationStatus    VerificationStatus        @default(UNVERIFIED)
  creditScore           Int                       @default(100)
  completedOrdersCount  Int                       @default(0)
  positiveReviewRate    Float                     @default(0)
  // 租赁统计字段
  rentalOwnerCount      Int                       @default(0)
  rentalRenterCount     Int                       @default(0)
  onTimeReturnRate      Float                     @default(0)
  rentalPositiveRate    Float                     @default(0)
  rentalDisputeCount    Int                       @default(0)
  // 上传存储配额：已占用字节数（含 PENDING_DELETE 待回收部分）。
  // 预留/释放走条件原子 UPDATE，见 src/lib/asset-service.ts
  storageUsedBytes      Int                       @default(0)
  lastLoginAt           DateTime?
  campusId              String
  campus                Campus                    @relation(fields: [campusId], references: [id])
  accounts              Account[]
  sessions              Session[]
  verification          UserVerification?
  products              Product[]
  favoriteProducts      Favorite[]
  errandFavorites       ErrandFavorite[]
  serviceFavorites      ServiceFavorite[]
  createdErrandTasks    ErrandTask[]              @relation("ErrandTaskPublisher")
  acceptedErrandTasks   ErrandTask[]              @relation("ErrandTaskAccepter")
  serviceListings       ServiceListing[]
  buyerOrders           Order[]                   @relation("OrderBuyer")
  sellerOrders          Order[]                   @relation("OrderSeller")
  sentMessages          Message[]                 @relation("MessageSender")
  conversationLinks     ConversationParticipant[]
  writtenReviews        Review[]                  @relation("ReviewAuthor")
  receivedReviews       Review[]                  @relation("ReviewTarget")
  reports               Report[]                  @relation("ReportReporter")
  receivedReports       Report[]                  @relation("ReportTargetUser")
  notifications         Notification[]
  blockedUsers          BlockedUser[]             @relation("BlockedByUser")
  blockedByUsers        BlockedUser[]             @relation("BlockedTargetUser")
  adminLogs             AdminLog[]                @relation("AdminActor")
  uploadedAssets        UploadedAsset[]           @relation("AssetOwner")
  // 租赁关联
  rentalListings        RentalListing[]           @relation("RentalOwner")
  rentalOrdersAsOwner   RentalOrder[]             @relation("RentalOrderOwner")
  rentalOrdersAsRenter  RentalOrder[]             @relation("RentalOrderRenter")
  rentalReviewsGiven    RentalReview[]            @relation("RentalReviewAuthor")
  rentalReviewsReceived RentalReview[]            @relation("RentalReviewTarget")
  rentalFavorites       RentalFavorite[]
  policyAcceptances     PolicyAcceptance[]
  privacyRequests       PrivacyRequest[]
  // Phase 6A：身份 / RBAC 关联
  memberships           CampusMembership[]
  userRoles             UserRoleAssignment[]
  reviewedVerifications UserVerification[]        @relation("VerificationReviewer")
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  deletedAt             DateTime?
  // 账号注销完成时间。与 deletedAt 互斥使用：注销保留行（pseudonymous id
  // 维持订单/评价/举报等历史引用），仅匿名化个人字段并吊销认证。
  erasedAt              DateTime?

  @@index([campusId, role])
  @@index([verificationStatus, status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Campus {
  id                   String                     @id @default(cuid())
  name                 String
  slug                 String                     @unique
  schoolName           String
  district             String?
  isActive             Boolean                    @default(true)
  users                User[]
  products             Product[]
  errandTasks          ErrandTask[]
  serviceListings      ServiceListing[]
  rentalListings       RentalListing[]
  // Phase 6A：Campus 为一等领域实体（租户/校园边界）
  memberships          CampusMembership[]
  verificationPolicies CampusVerificationPolicy[]
  userRoles            UserRoleAssignment[]
  adminLogs            AdminLog[]
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
}

// 校园成员认证记录（Phase 6A 演进：挂在 CampusMembership 上，而非全局 user）。
// 状态机：UNVERIFIED→PENDING→VERIFIED/REJECTED；REJECTED/REVOKED/VERIFIED→PENDING（重新提交）；
// VERIFIED→REVOKED（审核员吊销）。所有状态流转必须经
// src/lib/campus/verification-service.ts 的中央 transition service，禁止原地任意赋值。
// @@unique([userId]) 为当前产品"单 active campus"现状的表达；多校区展开时随
// CampusMembership 一并演进。历史迁移行 policy 三元组为 null（迁移前无 policy 机制，
// 保留 null 即真实证据，不伪造历史认证依据）。
model UserVerification {
  id               String                    @id @default(cuid())
  userId           String                    @unique
  membershipId     String                    @unique
  schoolName       String
  campusName       String
  studentIdLast4   String
  studentCardImage String
  status           VerificationStatus        @default(PENDING)
  reviewNote       String?
  // 审核决策机器可读原因码（如 VERIFICATION_MATERIALS_INVALID），可空
  reasonCode       String?
  submittedAt      DateTime                  @default(now())
  reviewedAt       DateTime?
  reviewedById     String?
  // 认证证据必须能反查其依据的 policy/version（发布后不可变，冗余快照三元组，
  // 与 PolicyAcceptance 同一工程原则）；迁移旧行为 null = 当时不存在 policy 机制
  policyId         String?
  policyVersion    Int?
  policyHash       String?
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership       CampusMembership          @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  reviewedBy       User?                     @relation("VerificationReviewer", fields: [reviewedById], references: [id])
  policy           CampusVerificationPolicy? @relation(fields: [policyId], references: [id])
  uploadedAssets   UploadedAsset[]           @relation("AssetVerification")
}

model ProductCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ErrandCategory {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  errandTasks ErrandTask[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ServiceCategory {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  sortOrder       Int              @default(0)
  isActive        Boolean          @default(true)
  serviceListings ServiceListing[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Product {
  id             String           @id @default(cuid())
  title          String
  description    String           @db.Text
  price          Decimal          @db.Decimal(10, 2)
  originalPrice  Decimal?         @db.Decimal(10, 2)
  locationText   String
  condition      ProductCondition
  status         ListingStatus    @default(ACTIVE)
  viewCount      Int              @default(0)
  favoriteCount  Int              @default(0)
  sellerId       String
  seller         User             @relation(fields: [sellerId], references: [id])
  campusId       String
  campus         Campus           @relation(fields: [campusId], references: [id])
  categoryId     String
  category       ProductCategory  @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  favorites      Favorite[]
  orders         Order[]
  conversations  Conversation[]
  reports        Report[]         @relation("ReportTargetProduct")
  uploadedAssets UploadedAsset[]  @relation("AssetProduct")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  @@index([campusId, status, createdAt])
  @@index([sellerId, status])
  @@index([categoryId, status])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model RentalFavorite {
  id              String        @id @default(cuid())
  userId          String
  rentalListingId String
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rentalListing   RentalListing @relation(fields: [rentalListingId], references: [id], onDelete: Cascade)

  @@unique([userId, rentalListingId])
  @@index([rentalListingId])
}

model ErrandFavorite {
  id           String     @id @default(cuid())
  userId       String
  errandTaskId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  errandTask   ErrandTask @relation(fields: [errandTaskId], references: [id], onDelete: Cascade)

  @@unique([userId, errandTaskId])
  @@index([errandTaskId])
}

model ServiceFavorite {
  id               String         @id @default(cuid())
  userId           String
  serviceListingId String
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceListing   ServiceListing @relation(fields: [serviceListingId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceListingId])
  @@index([serviceListingId])
}

model ErrandTask {
  id               String           @id @default(cuid())
  title            String
  description      String           @db.Text
  categoryId       String
  category         ErrandCategory   @relation(fields: [categoryId], references: [id])
  reward           Decimal          @db.Decimal(10, 2)
  pickupLocation   String
  deliveryLocation String
  contactNote      String?
  deadline         DateTime
  needsAdvancePay  Boolean          @default(false)
  advanceAmount    Decimal?         @db.Decimal(10, 2)
  status           ErrandTaskStatus @default(OPEN)
  publisherId      String
  publisher        User             @relation("ErrandTaskPublisher", fields: [publisherId], references: [id])
  accepterId       String?
  accepter         User?            @relation("ErrandTaskAccepter", fields: [accepterId], references: [id])
  campusId         String
  campus           Campus           @relation(fields: [campusId], references: [id])
  orders           Order[]
  conversations    Conversation[]
  reports          Report[]         @relation("ReportTargetErrand")
  favorites        ErrandFavorite[]
  favoriteCount    Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  @@index([campusId, status, deadline])
  @@index([publisherId, status])
  @@index([categoryId, status])
}

model ServiceListing {
  id                  String             @id @default(cuid())
  title               String
  description         String             @db.Text
  coverImageUrl       String?
  categoryId          String
  category            ServiceCategory    @relation(fields: [categoryId], references: [id])
  price               Decimal            @db.Decimal(10, 2)
  pricingUnit         ServicePricingUnit
  locationText        String
  availableSchedule   String?
  status              ListingStatus      @default(ACTIVE)
  completedOrderCount Int                @default(0)
  averageRating       Float              @default(0)
  providerId          String
  provider            User               @relation(fields: [providerId], references: [id])
  campusId            String
  campus              Campus             @relation(fields: [campusId], references: [id])
  orders              Order[]
  conversations       Conversation[]
  reports             Report[]           @relation("ReportTargetService")
  uploadedAssets      UploadedAsset[]    @relation("AssetServiceListing")
  favorites           ServiceFavorite[]
  favoriteCount       Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  @@index([campusId, status, createdAt])
  @@index([providerId, status])
  @@index([categoryId, status])
}

model Order {
  id               String          @id @default(cuid())
  orderNo          String          @unique
  type             OrderType
  status           OrderStatus     @default(PENDING)
  paymentStatus    PaymentStatus   @default(UNPAID)
  amount           Decimal         @db.Decimal(10, 2)
  meetingLocation  String?
  note             String?
  cancelReason     String?
  completedAt      DateTime?
  buyerId          String
  buyer            User            @relation("OrderBuyer", fields: [buyerId], references: [id])
  sellerId         String
  seller           User            @relation("OrderSeller", fields: [sellerId], references: [id])
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id])
  errandTaskId     String?
  errandTask       ErrandTask?     @relation(fields: [errandTaskId], references: [id])
  serviceListingId String?
  serviceListing   ServiceListing? @relation(fields: [serviceListingId], references: [id])
  reviews          Review[]
  notifications    Notification[]
  conversations    Conversation[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([type, status])
}

model Conversation {
  id               String                    @id @default(cuid())
  title            String?
  conversationKey  String?                   @unique
  productId        String?
  errandTaskId     String?
  serviceListingId String?
  rentalListingId  String?
  orderId          String?
  rentalOrderId    String?
  product          Product?                  @relation(fields: [productId], references: [id])
  errandTask       ErrandTask?               @relation(fields: [errandTaskId], references: [id])
  serviceListing   ServiceListing?           @relation(fields: [serviceListingId], references: [id])
  rentalListing    RentalListing?            @relation(fields: [rentalListingId], references: [id])
  order            Order?                    @relation(fields: [orderId], references: [id])
  rentalOrder      RentalOrder?              @relation(fields: [rentalOrderId], references: [id])
  participants     ConversationParticipant[]
  messages         Message[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, joinedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String?
  type           MessageType  @default(DIRECT)
  content        String       @db.Text
  isRead         Boolean      @default(false)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?        @relation("MessageSender", fields: [senderId], references: [id])
  reports        Report[]     @relation("ReportTargetMessage")
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Review {
  id           String   @id @default(cuid())
  orderId      String
  authorId     String
  targetUserId String
  rating       Int
  content      String?
  tags         String[]
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author       User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetUser   User     @relation("ReviewTarget", fields: [targetUserId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([orderId, authorId])
  @@index([targetUserId, createdAt])
}

model Report {
  id               String           @id @default(cuid())
  targetType       ReportTargetType
  reason           ReportReason
  detail           String?
  status           ReportStatus     @default(OPEN)
  reporterId       String
  targetUserId     String?
  productId        String?
  errandTaskId     String?
  serviceListingId String?
  rentalListingId  String?
  messageId        String?
  handledById      String?
  handledNote      String?
  handledAt        DateTime?
  reporter         User             @relation("ReportReporter", fields: [reporterId], references: [id])
  targetUser       User?            @relation("ReportTargetUser", fields: [targetUserId], references: [id])
  product          Product?         @relation("ReportTargetProduct", fields: [productId], references: [id])
  errandTask       ErrandTask?      @relation("ReportTargetErrand", fields: [errandTaskId], references: [id])
  serviceListing   ServiceListing?  @relation("ReportTargetService", fields: [serviceListingId], references: [id])
  rentalListing    RentalListing?   @relation("ReportTargetRental", fields: [rentalListingId], references: [id])
  message          Message?         @relation("ReportTargetMessage", fields: [messageId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  orderId   String?
  type      NotificationType
  title     String
  content   String
  isRead    Boolean          @default(false)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
}

model BlockedUser {
  id            String   @id @default(cuid())
  blockerId     String
  blockedUserId String
  reason        String?
  createdAt     DateTime @default(now())
  blocker       User     @relation("BlockedByUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUser   User     @relation("BlockedTargetUser", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
}

model ModerationKeyword {
  id          String               @id @default(cuid())
  keyword     String               @unique
  targetType  ModerationTargetType @default(GLOBAL)
  isEnabled   Boolean              @default(true)
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

// 管理审计日志（Phase 6A AdminAuditLog foundation，演进自既有 AdminLog）。
// append-only：业务层不提供任何 update/delete 入口；metadata 仅接受
// admin-audit 服务白名单键，禁止出现凭据/完整学号/私有对象键/私有 URL。
model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  detail     String?
  // campus-scoped 操作的目标校区（可空 = 全局操作）
  campusId   String?
  // 机器可读执行结果（6A 全部写入路径为 SUCCESS；失败尝试仅记结构化日志）
  result     String   @default("SUCCESS")
  // 白名单结构化元数据（经 recordAdminAudit 过滤），可空
  metadata   Json?
  createdAt  DateTime @default(now())
  admin      User     @relation("AdminActor", fields: [adminId], references: [id], onDelete: Cascade)
  campus     Campus?  @relation(fields: [campusId], references: [id])

  @@index([adminId, createdAt])
  @@index([targetType, targetId, createdAt])
}

// ============================================================
// 对象存储资源模型
// ============================================================

// 统一资源登记表：所有上传文件（公私）都以此表为可信记录，
// 业务表中的图片字段只存展示 URL（公开）或 asset:<id> 引用（私有）。
model UploadedAsset {
  id               String        @id @default(cuid())
  ownerId          String
  category         AssetCategory
  access           AssetAccess
  bucket           String // 写入时使用的 bucket 名（冗余存储，防 bucket 配置漂移）
  objectKey        String        @unique
  mimeType         String
  sizeBytes        Int // 重编码后实际存储大小
  width            Int?
  height           Int?
  originalFileName String? // 仅审计用途，绝不参与 object key 生成
  status           AssetStatus   @default(UPLOADED)
  // 业务绑定（上传时未知实体，attach 时回填；实体物理删除时置空）
  productId        String?
  rentalListingId  String?
  serviceListingId String?
  rentalOrderId    String?
  verificationId   String?
  attachedAt       DateTime?
  // 敏感资产保留期截止（如学生证材料），到期由 cleanup 删除对象但保留认证结论
  expiresAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  owner          User              @relation("AssetOwner", fields: [ownerId], references: [id])
  product        Product?          @relation("AssetProduct", fields: [productId], references: [id], onDelete: SetNull)
  rentalListing  RentalListing?    @relation("AssetRentalListing", fields: [rentalListingId], references: [id], onDelete: SetNull)
  serviceListing ServiceListing?   @relation("AssetServiceListing", fields: [serviceListingId], references: [id], onDelete: SetNull)
  rentalOrder    RentalOrder?      @relation("AssetRentalOrder", fields: [rentalOrderId], references: [id], onDelete: SetNull)
  verification   UserVerification? @relation("AssetVerification", fields: [verificationId], references: [id], onDelete: SetNull)

  @@index([ownerId, status])
  @@index([status, createdAt])
  @@index([expiresAt, status])
  @@index([productId])
  @@index([rentalListingId])
  @@index([serviceListingId])
  @@index([rentalOrderId])
}

// ============================================================
// 租赁模块枚举
// ============================================================

// ============================================================
// Phase 5：法务协议 / 隐私治理模块枚举
// ============================================================

enum LegalDocumentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  PLATFORM_RULES
  PROHIBITED_TRANSACTIONS
}

enum LegalDocumentStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

// 故意不提供 MIGRATION 来源：旧用户的重新同意必须来自真实用户行为，
// 不存在"迁移自动补同意"这个合法状态。
enum PolicyAcceptanceSource {
  SIGNUP
  RECONSENT
  SETTINGS
}

enum PrivacyRequestType {
  DATA_EXPORT
  ACCOUNT_DELETION
}

enum PrivacyRequestStatus {
  REQUESTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
  REJECTED
}

enum DataHoldType {
  LEGAL
  DISPUTE
}

enum DataHoldStatus {
  ACTIVE
  RELEASED
}

enum RentalListingStatus {
  AVAILABLE // 可出租
  PAUSED // 暂停出租
  FULLY_BOOKED // 已全部租出
  OFFLINE // 已下架
  PENDING_REVIEW // 审核中
  BANNED // 已封禁
}

enum RentalPricingUnit {
  PER_HOUR // 每小时
  PER_DAY // 每天
  PER_WEEK // 每周
  PER_MONTH // 每月
  PER_SESSION // 每次
}

enum RentalOrderStatus {
  PENDING_APPROVAL // 待出租者确认
  PENDING_PAYMENT // 待租客支付
  PENDING_PICKUP // 待取货
  PICKED_UP // 已取货
  IN_RENTAL // 租赁中
  PENDING_RETURN // 待归还
  PENDING_INSPECTION // 待出租者验收
  COMPLETED // 已完成
  REJECTED // 已拒绝
  CANCELLED // 已取消
  OVERDUE // 已逾期
  IN_DISPUTE // 纠纷处理中
  CLOSED // 已关闭
}

enum DepositStatus {
  NOT_REQUIRED // 无需押金
  PENDING_PAYMENT // 待支付
  PAID // 已支付
  FROZEN // 已冻结
  PENDING_REFUND // 待退回
  FULLY_REFUNDED // 已全部退回
  PARTIALLY_REFUNDED // 已部分退回
  FULLY_DEDUCTED // 已全部扣除
  IN_DISPUTE // 纠纷处理中
}

enum RentalCancellationReason {
  RENTER_CHANGED_PLAN // 租客改变计划
  OWNER_CANNOT_PROVIDE // 出租者无法提供
  CANNOT_CONTACT // 双方无法联系
  ITEM_DAMAGED // 物品临时损坏
  TIME_ERROR // 时间填写错误
  FAKE_INFO // 信息不真实
  OTHER // 其他原因
}

enum RentalDisputeStatus {
  OPEN // 待处理
  IN_REVIEW // 审核中
  RESOLVED // 已解决
  CLOSED // 已关闭
}

enum ExtensionRequestStatus {
  PENDING // 待审核
  APPROVED // 已同意
  REJECTED // 已拒绝
}

// ============================================================
// 租赁模块模型
// ============================================================

model RentalCategory {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  description    String?
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  rentalListings RentalListing[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model RentalListing {
  id                 String                    @id @default(cuid())
  ownerId            String
  owner              User                      @relation("RentalOwner", fields: [ownerId], references: [id])
  categoryId         String
  category           RentalCategory            @relation(fields: [categoryId], references: [id])
  campusId           String
  campus             Campus                    @relation(fields: [campusId], references: [id])
  title              String
  description        String                    @db.Text
  condition          ProductCondition
  brand              String?
  model              String?
  referenceValue     Decimal?                  @db.Decimal(10, 2)
  price              Decimal                   @db.Decimal(10, 2)
  pricingUnit        RentalPricingUnit
  depositAmount      Decimal                   @db.Decimal(10, 2)
  minimumDuration    Int // 最短租期（对应计价单位的数量）
  maximumDuration    Int // 最长租期（对应计价单位的数量）
  totalQuantity      Int                       @default(1)
  availableQuantity  Int                       @default(1)
  availableFrom      DateTime?
  availableUntil     DateTime?
  pickupLocation     String
  returnLocation     String
  usageRules         String?                   @db.Text
  damagePolicy       String?                   @db.Text
  overduePolicy      String?                   @db.Text
  requiresApproval   Boolean                   @default(true)
  status             RentalListingStatus       @default(AVAILABLE)
  viewCount          Int                       @default(0)
  favoriteCount      Int                       @default(0)
  images             RentalListingImage[]
  unavailablePeriods RentalUnavailablePeriod[]
  orders             RentalOrder[]
  reports            Report[]                  @relation("ReportTargetRental")
  uploadedAssets     UploadedAsset[]           @relation("AssetRentalListing")
  favorites          RentalFavorite[]
  conversations      Conversation[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  deletedAt          DateTime?

  @@index([campusId, status, createdAt])
  @@index([ownerId, status])
  @@index([categoryId, status])
  @@index([pricingUnit, status])
}

model RentalListingImage {
  id              String        @id @default(cuid())
  rentalListingId String
  url             String
  sortOrder       Int           @default(0)
  rentalListing   RentalListing @relation(fields: [rentalListingId], references: [id], onDelete: Cascade)
}

model RentalUnavailablePeriod {
  id              String        @id @default(cuid())
  rentalListingId String
  startDate       DateTime
  endDate         DateTime
  reason          String?
  rentalListing   RentalListing @relation(fields: [rentalListingId], references: [id], onDelete: Cascade)

  @@index([rentalListingId, startDate, endDate])
}

model RentalOrder {
  id                     String                    @id @default(cuid())
  orderNumber            String                    @unique
  rentalListingId        String
  rentalListing          RentalListing             @relation(fields: [rentalListingId], references: [id])
  ownerId                String
  owner                  User                      @relation("RentalOrderOwner", fields: [ownerId], references: [id])
  renterId               String
  renter                 User                      @relation("RentalOrderRenter", fields: [renterId], references: [id])
  startTime              DateTime
  endTime                DateTime
  actualReturnTime       DateTime?
  quantity               Int                       @default(1)
  // 价格快照（下单时保存，不受后续修改影响）
  unitPriceSnapshot      Decimal                   @db.Decimal(10, 2)
  pricingUnitSnapshot    RentalPricingUnit
  rentalDuration         Int // 租赁时长（计价单位数量）
  rentalAmount           Decimal                   @db.Decimal(10, 2)
  depositAmount          Decimal                   @db.Decimal(10, 2)
  serviceFee             Decimal                   @default(0) @db.Decimal(10, 2)
  overdueFee             Decimal                   @default(0) @db.Decimal(10, 2)
  depositDeduction       Decimal                   @default(0) @db.Decimal(10, 2)
  finalAmount            Decimal                   @db.Decimal(10, 2)
  cancellationFee        Decimal                   @default(0) @db.Decimal(10, 2)
  paymentStatus          PaymentStatus             @default(UNPAID)
  depositStatus          DepositStatus             @default(NOT_REQUIRED)
  status                 RentalOrderStatus         @default(PENDING_APPROVAL)
  pickupLocationSnapshot String
  returnLocationSnapshot String
  renterNote             String?
  cancellationReason     RentalCancellationReason?
  cancellationNote       String?
  cancelledById          String?
  cancelledAt            DateTime?
  handoverRecord         RentalHandoverRecord?
  returnRecord           RentalReturnRecord?
  extensionRequests      RentalExtensionRequest[]
  damageClaims           RentalDamageClaim[]
  disputes               RentalDispute[]
  statusLogs             RentalOrderStatusLog[]
  reviews                RentalReview[]
  conversations          Conversation[]
  uploadedAssets         UploadedAsset[]           @relation("AssetRentalOrder")
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  completedAt            DateTime?

  @@index([rentalListingId, status])
  @@index([ownerId, status, createdAt])
  @@index([renterId, status, createdAt])
  @@index([status, startTime, endTime])
  @@index([rentalListingId, startTime, endTime])
}

model RentalOrderStatusLog {
  id         String             @id @default(cuid())
  orderId    String
  order      RentalOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus RentalOrderStatus?
  toStatus   RentalOrderStatus
  operatorId String?
  note       String?
  createdAt  DateTime           @default(now())

  @@index([orderId, createdAt])
}

model RentalHandoverRecord {
  id                String      @id @default(cuid())
  orderId           String      @unique
  order             RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  photos            String[] // 图片 URL 数组
  accessories       String?     @db.Text // 配件清单
  currentCondition  String?     @db.Text // 物品当前状态
  knownIssues       String?     @db.Text // 已知问题
  renterConfirmed   Boolean     @default(false)
  ownerConfirmed    Boolean     @default(false)
  renterConfirmedAt DateTime?
  ownerConfirmedAt  DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model RentalReturnRecord {
  id                  String      @id @default(cuid())
  orderId             String      @unique
  order               RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  photos              String[] // 图片 URL 数组
  accessoriesComplete Boolean     @default(true)
  hasDamage           Boolean     @default(false)
  needsCleaning       Boolean     @default(false)
  isOverdue           Boolean     @default(false)
  overdueDuration     Int? // 逾期时长（分钟）
  inspectionNote      String?     @db.Text
  renterConfirmed     Boolean     @default(false)
  ownerConfirmed      Boolean     @default(false)
  renterConfirmedAt   DateTime?
  ownerConfirmedAt    DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model RentalExtensionRequest {
  id            String                 @id @default(cuid())
  orderId       String
  order         RentalOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requesterId   String
  newEndTime    DateTime
  additionalFee Decimal                @db.Decimal(10, 2)
  status        ExtensionRequestStatus @default(PENDING)
  ownerNote     String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([orderId, createdAt])
}

model RentalDamageClaim {
  id                 String      @id @default(cuid())
  orderId            String
  order              RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  submittedById      String // 提交人（通常是出租者）
  damageDescription  String      @db.Text
  photos             String[] // 损坏图片 URL 数组
  requestedDeduction Decimal     @db.Decimal(10, 2)
  approvedDeduction  Decimal?    @db.Decimal(10, 2)
  renterAgreed       Boolean?
  renterNote         String?
  resolvedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([orderId])
}

model RentalDispute {
  id             String              @id @default(cuid())
  orderId        String
  order          RentalOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  initiatorId    String
  reason         String              @db.Text
  evidencePhotos String[]
  status         RentalDisputeStatus @default(OPEN)
  adminNote      String?             @db.Text
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
}

model RentalReview {
  id                  String      @id @default(cuid())
  orderId             String
  order               RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId            String
  author              User        @relation("RentalReviewAuthor", fields: [authorId], references: [id])
  targetUserId        String
  targetUser          User        @relation("RentalReviewTarget", fields: [targetUserId], references: [id])
  // 租客评价维度
  itemMatchDesc       Int? // 物品符合描述 1-5
  itemWorksWell       Int? // 物品使用正常 1-5
  ownerResponsive     Int? // 出租者回复及时 1-5
  pickupEasy          Int? // 取还方便 1-5
  attitudeFriendly    Int? // 态度友好 1-5
  // 出租者评价维度
  returnedOnTime      Int? // 按时归还 1-5
  itemWellKept        Int? // 爱护物品 1-5
  accessoriesComplete Int? // 配件完整 1-5
  goodCommunication   Int? // 沟通顺畅 1-5
  reliable            Int? // 守约可靠 1-5
  // 综合
  overallRating       Int // 综合评分 1-5
  content             String?     @db.Text
  tags                String[]
  createdAt           DateTime    @default(now())

  @@unique([orderId, authorId])
  @@index([targetUserId, createdAt])
  @@index([orderId])
}

// ============================================================
// Phase 5：法务协议 / 隐私治理模型
// ============================================================

// 版本化法务/平台政策文档。核心不变量：PUBLISHED 即不可变——
// type/version/content/contentHash/effectiveAt/requiresAcceptance 一经发布
// 不得原地修改，需要变更必须创建新版本（由 LegalDocumentService 强制）。
model LegalDocument {
  id                 String              @id @default(cuid())
  type               LegalDocumentType
  version            Int
  status             LegalDocumentStatus @default(DRAFT)
  title              String
  content            String              @db.Text
  // 对 canonical content（UTF-8 原文）的 SHA-256，hex 小写。
  // acceptance 证据必须能反查到确切 id/version/hash。
  contentHash        String
  effectiveAt        DateTime
  publishedAt        DateTime?
  requiresAcceptance Boolean             @default(true)
  createdById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  acceptances        PolicyAcceptance[]

  @@unique([type, version])
  @@index([type, status, effectiveAt])
}

// 同意证据（审计记录）：创建后不得改写为另一个 version/hash。
// @@unique([userId, documentId]) 保证幂等：并发双击不会产生重复证据。
model PolicyAcceptance {
  id              String                 @id @default(cuid())
  userId          String
  documentId      String
  // 发布文档不可变，这里仍冗余快照三元组：证据自身自足，不依赖联表还原。
  documentType    LegalDocumentType
  documentVersion Int
  documentHash    String
  source          PolicyAcceptanceSource
  acceptedAt      DateTime               @default(now())
  createdAt       DateTime               @default(now())
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  document        LegalDocument          @relation(fields: [documentId], references: [id])

  @@unique([userId, documentId])
  @@index([userId, acceptedAt])
  @@index([documentId])
}

// 隐私请求（数据导出 / 账号注销）。状态只能经显式 transition helper 流转，
// 禁止任意赋值跳状态。ACCOUNT_DELETION 的"同一用户至多一个 active 请求"
// 由迁移 SQL 中的部分唯一索引兜底。
model PrivacyRequest {
  id          String               @id @default(cuid())
  userId      String
  type        PrivacyRequestType
  status      PrivacyRequestStatus @default(REQUESTED)
  // BLOCKED/REJECTED 时的机器可读原因（如 ACTIVE_DATA_HOLD / ACTIVE_TRANSACTION_BLOCK）
  reasonCode  String?
  handledNote String?
  requestedAt DateTime             @default(now())
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, status])
  @@index([status, requestedAt])
}

// 数据保留 / 纠纷冻结（Legal Hold / Dispute Hold）。
// ACTIVE hold 必须阻断破坏性擦除与保留期清理；hold 校验必须在破坏性事务
// 内部二次执行（防 TOCTOU）。创建/解除入口在 Phase 5 仅暴露 service seam
// （测试/seed 使用），管理界面属于 Phase 7。
model DataHold {
  id           String         @id @default(cuid())
  type         DataHoldType
  status       DataHoldStatus @default(ACTIVE)
  // 预留作用域（当前仅 USER_ACCOUNT），Phase 6/7 扩展时无需改表
  scope        String         @default("USER_ACCOUNT")
  subjectType  String         @default("USER")
  subjectId    String
  reasonCode   String
  note         String?
  createdById  String?
  createdAt    DateTime       @default(now())
  releasedAt   DateTime?
  releasedById String?

  @@index([subjectType, subjectId, status])
  @@index([status, type, createdAt])
}

// ============================================================
// Phase 6A：身份 / 校园成员 / 认证策略 / RBAC 模型
// ============================================================

enum CampusMembershipStatus {
  // 已申请加入（6A 注册路径直接 ACTIVE，PENDING 为未来加入审批预留）
  PENDING
  ACTIVE
  REJECTED
  // 校园级停用（账号级停用仍在 User.status，二者独立判定，均须 ACTIVE 才放行）
  SUSPENDED
  LEFT
}

enum RoleScope {
  // 平台级角色：权限覆盖所有校区
  GLOBAL
  // 校园级角色：权限仅在 campusId 匹配的目标校区内生效
  CAMPUS
}

// 与 LegalDocument 同一版本化原则：PUBLISHED 即不可变
// （version/instructions/contentHash/effectiveAt 一经发布不得原地修改），
// 变更必须创建更高版本；current = PUBLISHED + effectiveAt<=now 中 version 最高。
enum CampusVerificationPolicyStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

// User ↔ Campus 的成员关系。membership 存在 != membership active；
// 一切 campus-scoped 操作必须经中央 resolver
// （src/lib/campus/membership-service.ts）解析 ACTIVE membership。
model CampusMembership {
  id            String                 @id @default(cuid())
  userId        String
  campusId      String
  status        CampusMembershipStatus @default(PENDING)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus        Campus                 @relation(fields: [campusId], references: [id])
  // 当前产品单 active campus：一个 membership 至多一条认证记录
  verifications UserVerification[]

  // membership 身份唯一性由数据库表达，不依赖 TypeScript if
  @@unique([userId, campusId])
  @@index([userId, status])
  @@index([campusId, status])
}

// 校园认证策略（per-campus 版本化）。创建/发布入口 6A 仅暴露 service seam
// （测试/seed 使用），管理界面属于 Phase 7，与 LegalDocument 同先例。
model CampusVerificationPolicy {
  id            String                         @id @default(cuid())
  campusId      String
  campus        Campus                         @relation(fields: [campusId], references: [id])
  version       Int
  status        CampusVerificationPolicyStatus @default(DRAFT)
  title         String
  // 展示给用户的认证要求说明；canonical content = 本字段 UTF-8 原文
  instructions  String                         @db.Text
  // 对 canonical content 的 SHA-256（hex 小写），认证证据反查用
  contentHash   String
  effectiveAt   DateTime
  publishedAt   DateTime?
  createdById   String?
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt
  verifications UserVerification[]

  @@unique([campusId, version])
  @@index([campusId, status, effectiveAt])
}

// 角色是 permission 的集合。业务授权依据是 permission，不是 role name：
// 禁止 `role.key === "PLATFORM_ADMIN"` 之类业务判断，一律走
// src/lib/rbac/service.ts 的 hasPermission / requirePermission。
model Role {
  id              String               @id @default(cuid())
  key             String               @unique
  name            String
  scope           RoleScope            @default(GLOBAL)
  // 系统内置角色不可删除；权限集合只能通过 bootstrap 幂等收敛
  isSystem        Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  rolePermissions RolePermission[]
  userRoles       UserRoleAssignment[]
}

// permission key 为稳定 machine-readable 标识（如 "verification.review"），
// 定义唯一来源：src/lib/rbac/permissions.ts。未知 permission 一律 DENY。
model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

// 角色授予。GLOBAL 角色行 campusId 为 null、scopeKey="GLOBAL"；
// CAMPUS 角色行 campusId 必填、scopeKey="CAMPUS:<campusId>"。
// scopeKey 兜底 Postgres 唯一约束不把 NULL 视为相等的问题，
// 与 campusId 的一致性由 assignment service 维护。
// 角色授予（命名注：与遗留 UserRole 枚举区分；遗留枚举仅为 User.role 展示字段服务）。
// GLOBAL 角色行 campusId 为 null、scopeKey="GLOBAL"；
// CAMPUS 角色行 campusId 必填、scopeKey="CAMPUS:<campusId>"。
// scopeKey 兜底 Postgres 唯一约束不把 NULL 视为相等的问题，
// 与 campusId 的一致性由 assignment service 维护。
model UserRoleAssignment {
  id           String   @id @default(cuid())
  userId       String
  roleId       String
  campusId     String?
  scopeKey     String
  assignedById String?
  assignedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  campus       Campus?  @relation(fields: [campusId], references: [id])

  @@unique([userId, roleId, scopeKey])
  @@index([userId])
  @@index([roleId])
}
