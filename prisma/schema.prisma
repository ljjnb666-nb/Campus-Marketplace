// 租赁模块枚举
// ============================================================

// ============================================================
// Phase 5：法务协议 / 隐私治理模块枚举
// ============================================================

enum LegalDocumentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  PLATFORM_RULES
  PROHIBITED_TRANSACTIONS
}

enum LegalDocumentStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

// 故意不提供 MIGRATION 来源：旧用户的重新同意必须来自真实用户行为，
// 不存在"迁移自动补同意"这个合法状态。
enum PolicyAcceptanceSource {
  SIGNUP
  RECONSENT
  SETTINGS
}

enum PrivacyRequestType {
  DATA_EXPORT
  ACCOUNT_DELETION
}

enum PrivacyRequestStatus {
  REQUESTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
  REJECTED
}

enum DataHoldType {
  LEGAL
  DISPUTE
}

enum DataHoldStatus {
  ACTIVE
  RELEASED
}

enum RentalListingStatus {
  AVAILABLE // 可出租
  PAUSED // 暂停出租
  FULLY_BOOKED // 已全部租出
  OFFLINE // 已下架
  PENDING_REVIEW // 审核中
  BANNED // 已封禁
}

enum RentalPricingUnit {
  PER_HOUR // 每小时
  PER_DAY // 每天
  PER_WEEK // 每周
  PER_MONTH // 每月
  PER_SESSION // 每次
}

enum RentalOrderStatus {
  PENDING_APPROVAL // 待出租者确认
  PENDING_PAYMENT // 待租客支付
  PENDING_PICKUP // 待取货
  PICKED_UP // 已取货
  IN_RENTAL // 租赁中
  PENDING_RETURN // 待归还
  PENDING_INSPECTION // 待出租者验收
  COMPLETED // 已完成
  REJECTED // 已拒绝
  CANCELLED // 已取消
  OVERDUE // 已逾期
  IN_DISPUTE // 纠纷处理中
  CLOSED // 已关闭
}

enum DepositStatus {
  NOT_REQUIRED // 无需押金
  PENDING_PAYMENT // 待支付
  PAID // 已支付
  FROZEN // 已冻结
  PENDING_REFUND // 待退回
  FULLY_REFUNDED // 已全部退回
  PARTIALLY_REFUNDED // 已部分退回
  FULLY_DEDUCTED // 已全部扣除
  IN_DISPUTE // 纠纷处理中
}

enum RentalCancellationReason {
  RENTER_CHANGED_PLAN // 租客改变计划
  OWNER_CANNOT_PROVIDE // 出租者无法提供
  CANNOT_CONTACT // 双方无法联系
  ITEM_DAMAGED // 物品临时损坏
  TIME_ERROR // 时间填写错误
  FAKE_INFO // 信息不真实
  OTHER // 其他原因
}

enum RentalDisputeStatus {
  OPEN // 待处理
  IN_REVIEW // 审核中
  RESOLVED // 已解决
  CLOSED // 已关闭
}

// Phase 7G：纠纷终局时对订单的机器可读收敛动作。
// RESTORE_PREVIOUS = 订单回到 openedFromOrderStatus（null 时 DENY，绝不猜历史）；
// CLOSE_ORDER = 订单进入 CLOSED。禁止在此层表达 refund / 押金 / payout 等
// payment 语义（金额字段不由 dispute resolution 修改，GATE C 冻结）。
enum DisputeResolutionAction {
  RESTORE_PREVIOUS
  CLOSE_ORDER
}

// Phase 7G：纠纷处理结果的中性运营原因码。
// 刻意不设 OWNER_GUILTY / RENTER_GUILTY / FRAUD_CONFIRMED 之类的
// 越权码——dispute resolution 不是 enforcement truth；需要处罚必须
// 单独走 canonical enforcement service，本域不得产生 EnforcementAction。
enum DisputeResolutionCode {
  MUTUAL_AGREEMENT
  OPERATIONAL_REMEDIATION
  EVIDENCE_INSUFFICIENT
  DUPLICATE
  INVALID
  OTHER
}

// ============================================================
// Phase 7G：Support Ticket（支持工单域）
// ============================================================

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketCategory {
  ACCOUNT
  VERIFICATION
  MARKETPLACE
  SAFETY
  OTHER
}

// 支持工单处理结果原因码（与 DisputeResolutionCode 是独立 taxonomy，
// 禁止 cast/复用）。USER_VISIBLE 的 resolutionMessage / OPERATOR_ONLY 的
// internalNote 是两个分离字段，读面必须分别授权。
enum SupportResolutionCode {
  ANSWERED
  USER_GUIDED
  DUPLICATE
  INVALID
  OUT_OF_SCOPE
  OTHER
}

enum ExtensionRequestStatus {
  PENDING // 待审核
  APPROVED // 已同意
  REJECTED // 已拒绝
}

// ============================================================
// 租赁模块模型
// ============================================================

model RentalCategory {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  description    String?
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  rentalListings RentalListing[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model RentalListing {
  id                 String                    @id @default(cuid())
  ownerId            String
  owner              User                      @relation("RentalOwner", fields: [ownerId], references: [id])
  categoryId         String
  category           RentalCategory            @relation(fields: [categoryId], references: [id])
  campusId           String
  campus             Campus                    @relation(fields: [campusId], references: [id])
  title              String
  description        String                    @db.Text
  condition          ProductCondition
  brand              String?
  model              String?
  referenceValue     Decimal?                  @db.Decimal(10, 2)
  price              Decimal                   @db.Decimal(10, 2)
  pricingUnit        RentalPricingUnit
  depositAmount      Decimal                   @db.Decimal(10, 2)
  minimumDuration    Int // 最短租期（对应计价单位的数量）
  maximumDuration    Int // 最长租期（对应计价单位的数量）
  totalQuantity      Int                       @default(1)
  availableQuantity  Int                       @default(1)
  availableFrom      DateTime?
  availableUntil     DateTime?
  pickupLocation     String
  returnLocation     String
  usageRules         String?                   @db.Text
  damagePolicy       String?                   @db.Text
  overduePolicy      String?                   @db.Text
  requiresApproval   Boolean                   @default(true)
  status             RentalListingStatus       @default(AVAILABLE)
  viewCount          Int                       @default(0)
  favoriteCount      Int                       @default(0)
  images             RentalListingImage[]
  unavailablePeriods RentalUnavailablePeriod[]
  orders             RentalOrder[]
  reports            Report[]                  @relation("ReportTargetRental")
  uploadedAssets     UploadedAsset[]           @relation("AssetRentalListing")
  favorites          RentalFavorite[]
  conversations      Conversation[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  deletedAt          DateTime?

  // Phase 7C：治理 overlay（活跃行 = 隐藏中；业务 status 零变更；
  // PENDING_REVIEW / BANNED 为既有死枚举，Phase 7C 禁止启用）
  moderations ListingModeration[] @relation("ModerationTargetRental")

  // FINAL REPAIR A：/rentals 默认序 + popular 排序
  @@index([campusId, status, createdAt])
  @@index([ownerId, status])
  @@index([categoryId, status])
  @@index([pricingUnit, status])
  @@index([createdAt(sort: Desc)])
  @@index([favoriteCount(sort: Desc), createdAt(sort: Desc)])
}

model RentalListingImage {
  id              String        @id @default(cuid())
  rentalListingId String
  url             String
  sortOrder       Int           @default(0)
  rentalListing   RentalListing @relation(fields: [rentalListingId], references: [id], onDelete: Cascade)
}

model RentalUnavailablePeriod {
  id              String        @id @default(cuid())
  rentalListingId String
  startDate       DateTime
  endDate         DateTime
  reason          String?
  rentalListing   RentalListing @relation(fields: [rentalListingId], references: [id], onDelete: Cascade)

  @@index([rentalListingId, startDate, endDate])
}

model RentalOrder {
  id                     String                    @id @default(cuid())
  orderNumber            String                    @unique
  rentalListingId        String
  rentalListing          RentalListing             @relation(fields: [rentalListingId], references: [id])
  ownerId                String
  owner                  User                      @relation("RentalOrderOwner", fields: [ownerId], references: [id])
  renterId               String
  renter                 User                      @relation("RentalOrderRenter", fields: [renterId], references: [id])
  startTime              DateTime
  endTime                DateTime
  actualReturnTime       DateTime?
  quantity               Int                       @default(1)
  // 价格快照（下单时保存，不受后续修改影响）
  unitPriceSnapshot      Decimal                   @db.Decimal(10, 2)
  pricingUnitSnapshot    RentalPricingUnit
  rentalDuration         Int // 租赁时长（计价单位数量）
  rentalAmount           Decimal                   @db.Decimal(10, 2)
  depositAmount          Decimal                   @db.Decimal(10, 2)
  serviceFee             Decimal                   @default(0) @db.Decimal(10, 2)
  overdueFee             Decimal                   @default(0) @db.Decimal(10, 2)
  depositDeduction       Decimal                   @default(0) @db.Decimal(10, 2)
  finalAmount            Decimal                   @db.Decimal(10, 2)
  cancellationFee        Decimal                   @default(0) @db.Decimal(10, 2)
  paymentStatus          PaymentStatus             @default(UNPAID)
  depositStatus          DepositStatus             @default(NOT_REQUIRED)
  status                 RentalOrderStatus         @default(PENDING_APPROVAL)
  pickupLocationSnapshot String
  returnLocationSnapshot String
  renterNote             String?
  cancellationReason     RentalCancellationReason?
  cancellationNote       String?
  cancelledById          String?
  cancelledAt            DateTime?
  handoverRecord         RentalHandoverRecord?
  returnRecord           RentalReturnRecord?
  extensionRequests      RentalExtensionRequest[]
  damageClaims           RentalDamageClaim[]
  disputes               RentalDispute[]
  statusLogs             RentalOrderStatusLog[]
  reviews                RentalReview[]
  conversations          Conversation[]
  uploadedAssets         UploadedAsset[]           @relation("AssetRentalOrder")
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  completedAt            DateTime?

  @@index([rentalListingId, status])
  @@index([ownerId, status, createdAt])
  @@index([renterId, status, createdAt])
  @@index([status, startTime, endTime])
  @@index([rentalListingId, startTime, endTime])
}

model RentalOrderStatusLog {
  id         String             @id @default(cuid())
  orderId    String
  order      RentalOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus RentalOrderStatus?
  toStatus   RentalOrderStatus
  operatorId String?
  note       String?
  createdAt  DateTime           @default(now())

  @@index([orderId, createdAt])
}

model RentalHandoverRecord {
  id                String      @id @default(cuid())
  orderId           String      @unique
  order             RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  photos            String[] // 图片 URL 数组
  accessories       String?     @db.Text // 配件清单
  currentCondition  String?     @db.Text // 物品当前状态
  knownIssues       String?     @db.Text // 已知问题
  renterConfirmed   Boolean     @default(false)
  ownerConfirmed    Boolean     @default(false)
  renterConfirmedAt DateTime?
  ownerConfirmedAt  DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model RentalReturnRecord {
  id                  String      @id @default(cuid())
  orderId             String      @unique
  order               RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  photos              String[] // 图片 URL 数组
  accessoriesComplete Boolean     @default(true)
  hasDamage           Boolean     @default(false)
  needsCleaning       Boolean     @default(false)
  isOverdue           Boolean     @default(false)
  overdueDuration     Int? // 逾期时长（分钟）
  inspectionNote      String?     @db.Text
  renterConfirmed     Boolean     @default(false)
  ownerConfirmed      Boolean     @default(false)
  renterConfirmedAt   DateTime?
  ownerConfirmedAt    DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model RentalExtensionRequest {
  id            String                 @id @default(cuid())
  orderId       String
  order         RentalOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requesterId   String
  newEndTime    DateTime
  additionalFee Decimal                @db.Decimal(10, 2)
  status        ExtensionRequestStatus @default(PENDING)
  ownerNote     String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([orderId, createdAt])
}

model RentalDamageClaim {
  id                 String      @id @default(cuid())
  orderId            String
  order              RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  submittedById      String // 提交人（通常是出租者）
  damageDescription  String      @db.Text
  photos             String[] // 损坏图片 URL 数组
  requestedDeduction Decimal     @db.Decimal(10, 2)
  approvedDeduction  Decimal?    @db.Decimal(10, 2)
  renterAgreed       Boolean?
  renterNote         String?
  resolvedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([orderId])
}

// Phase 7G：租赁纠纷治理域。RentalDispute = dispute workflow / resolution
// truth（≠ Order / ≠ Enforcement / ≠ Payment）。订单仍是 fulfillment truth。
// - campus 快照（campusId + scopeKey exact pair）创建时从
//   RentalOrder → RentalListing.campusId 派生，immutable（DB CHECK 兜底）；
//   禁止以 User.campusId / 当事人 membership 作为 dispute authorization truth。
// - openedFromOrderStatus：进入 IN_DISPUTE 前的订单状态快照；运行时写入恒
//   non-null（历史行由迁移从 RentalOrderStatusLog 回填，不可靠还原 → NULL，
//   禁止伪造）；RESTORE_PREVIOUS 语义以本列为唯一依据（NULL → DENY）。
// - 同一订单至多一个 active dispute（OPEN/IN_REVIEW）——由迁移中的
//   PostgreSQL partial unique index 强制（terminal 历史不阻断未来新 episode）。
// - resolutionAction/code 为中性运营 taxonomy：本域绝不产生 EnforcementAction，
//   绝不修改任何金额字段（refund/押金/payout 均为 Phase 8+/payment 禁区）。
model RentalDispute {
  id             String              @id @default(cuid())
  orderId        String
  order          RentalOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  initiatorId    String
  reason         String              @db.Text
  evidencePhotos String[]
  status         RentalDisputeStatus @default(OPEN)

  // Phase 7G：campus scope 快照（immutable；创建时 snapshot，绝不回猜）
  campusId String
  campus   Campus @relation("RentalDisputeScopeCampus", fields: [campusId], references: [id], onDelete: Restrict)
  scopeKey String

  // 进入 IN_DISPUTE 前的订单状态（RESTORE_PREVIOUS 唯一依据；null = 历史残缺）
  openedFromOrderStatus RentalOrderStatus?

  // 运营领用（claim/release；SetNull：领用人引用消失时 dispute 仍在）
  assignedToId String?
  assignedTo   User?   @relation("DisputeAssignee", fields: [assignedToId], references: [id])

  // 处理 SLA：创建时 = createdAt + 48h（唯一运行时写路径；历史行由迁移回填）。
  // OVERDUE 只读判定 = status IN (OPEN, IN_REVIEW) ∧ dueAt < now，
  // 不驱动任何自动决定 / restriction / suspension。
  dueAt DateTime

  // 终局（RESOLVED / CLOSED）写入；dispute state machine 禁止 reopen
  resolutionCode   DisputeResolutionCode?
  resolutionAction DisputeResolutionAction?

  // 正名：列名保持历史 "resolvedBy" 不变（@map 避免无必要 DB rename）；
  // 治理 provenance 裸字符串（无 FK），不随 reviewer 账户消失被改写
  resolvedById String?   @map("resolvedBy")
  resolvedAt   DateTime?

  // 操作员内部备注（OPERATOR_ONLY；queue 结构性不返回，仅授权详情面）
  adminNote String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
  // 治理队列排序 keyset tuple（dueAt ASC, createdAt ASC, id ASC）
  @@index([dueAt, createdAt, id])
  // campus reviewer exact-pair 授权谓词
  @@index([campusId, scopeKey])
  @@index([assignedToId])
}

// ============================================================
// Phase 8C-01：General OrderDispute（PRODUCT / SERVICE / ERRAND 交易纠纷域）
// ============================================================
// 领域边界（冻结）：Report != Dispute；SupportTicket != Dispute；
// RentalDispute != General OrderDispute。RentalDispute 绑定 rental 专属
// lifecycle（deposit / pickup / return / damage claim / extension），General
// Order 使用独立的 OrderDispute，但共享 dispute.review permission、campus
// scope 语义、DisputeResolutionCode/Action、DataHold primitives、48h SLA
// 与 governance lock discipline（不复制 RBAC 角色）。
model OrderDispute {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation("OrderDisputeOrder", fields: [orderId], references: [id], onDelete: Cascade)

  initiatorId String
  initiator   User   @relation("OrderDisputeInitiator", fields: [initiatorId], references: [id], onDelete: Restrict)

  reason         String   @db.Text
  evidencePhotos String[]

  status OrderDisputeStatus @default(OPEN)

  // campus scope immutable snapshot（创建时从交易标的归属 campus 取得，
  // 绝不以 User.campusId / initiator current campus 回猜；DB CHECK 冻结 pair）
  campusId String
  campus   Campus @relation("OrderDisputeScopeCampus", fields: [campusId], references: [id], onDelete: Restrict)
  scopeKey String

  // 进入 IN_DISPUTE 前的 Order 状态（RESTORE_PREVIOUS 唯一依据；新表无
  // legacy rows，运行时恒非 null）
  openedFromOrderStatus OrderStatus

  // ERRAND canonical pair 的 Task 侧快照；非 ERRAND 恒 null
  openedFromErrandStatus ErrandTaskStatus?

  // 运营领用（claim/release；SetNull：领用人引用消失时 dispute 仍在）
  assignedToId String?
  assignedTo   User?   @relation("OrderDisputeAssignee", fields: [assignedToId], references: [id])

  // 处理 SLA：创建时 = createdAt + 48h（复用 Phase 7G computeDisputeDueAt，
  // 唯一运行时写路径；OVERDUE 只读判定，不驱动自动决定）
  dueAt DateTime

  // 终局（RESOLVED / CLOSED）写入；dispute state machine 禁止 reopen。
  // 复用 7G 中性码（本域不得产生 refund / payment 语义）
  resolutionCode   DisputeResolutionCode?
  resolutionAction DisputeResolutionAction?

  // 治理 provenance 裸字符串（无 FK），不随 reviewer 账户消失被改写
  resolvedById String?
  resolvedAt   DateTime?

  // 操作员内部备注（OPERATOR_ONLY；queue 结构性不返回，仅授权详情面）
  adminNote String? @db.Text

  // Phase 8D-01：no-show trigger provenance——该 dispute 由哪个 meetup 的
  // no-show 报告触发（普通用户手动 dispute 恒 null；SetNull：dispute 行
  // 随 Order 级联消失时 meetup provenance 保留）
  triggeredByMeetup OrderMeetup? @relation("OrderMeetupTriggeredDispute")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
  @@index([dueAt, createdAt, id])
  @@index([campusId, scopeKey])
  @@index([assignedToId])
}

// ============================================================
// Phase 8D-01：General Order Meetup / MeetupPoint（PRODUCT / SERVICE 专属）
// ============================================================
// 领域边界（冻结）：Meetup domain 只支持 PRODUCT / SERVICE General Order
// （两类均有 meetingLocation 下单快照 + 真实面对面履约语义）。ERRAND（已有
// pickupLocation/deliveryLocation + ErrandTask lifecycle）与 RENTAL（已有
// RentalHandoverRecord / RentalReturnRecord 专属语义）不进入本域——不同
// aggregate 不得复用 Meetup 改写既有履约事实。
//
// 权威状态冻结：Order.meetingLocation 自此只是下单时初始偏好快照；正式见面
// 约定 authority = OrderMeetup（locationTextSnapshot / scheduledAt / status /
// arrival fields）。MeetupPoint 是 campus catalog 参考数据（来源）；改名 /
// 停用绝不改写历史 OrderMeetup.locationTextSnapshot（transaction snapshot
// authority）。
//
// 状态 mutation authority = src/lib/meetups/order-meetup-service.ts 的
// canonical Tx services（锁序冻结：sorted USER pair → Order FOR UPDATE →
// OrderMeetup FOR UPDATE；禁止 OrderMeetup → Order 反序 deadlock surface）。
// NO_SHOW_REPORTED 与 OrderDispute OPEN + Order IN_DISPUTE 同事务原子提交。
model MeetupPoint {
  id           String        @id @default(cuid())
  campusId     String
  campus       Campus        @relation("MeetupPointCampus", fields: [campusId], references: [id], onDelete: Restrict)
  name         String
  locationText String
  isActive     Boolean       @default(true)
  meetups      OrderMeetup[] @relation("MeetupPointMeetup")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([campusId, name])
  @@index([campusId, isActive])
}

model OrderMeetup {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation("OrderMeetupOrder", fields: [orderId], references: [id], onDelete: Cascade)

  // campus 权威快照：创建时从交易标的归属 campus 取得（PRODUCT →
  // Product.campusId / SERVICE → ServiceListing.campusId），绝不允许来自
  // User.campusId / 当前用户 campus / 客户端字段；immutable，无更新写路径
  campusId String
  campus   Campus @relation("OrderMeetupCampus", fields: [campusId], references: [id], onDelete: Restrict)

  // catalog 来源（可空；SetNull：点删除/失效不破坏历史 meetup）
  meetupPointId String?
  meetupPoint   MeetupPoint? @relation("MeetupPointMeetup", fields: [meetupPointId], references: [id], onDelete: SetNull)

  // location transaction snapshot authority：无论来源（MeetupPoint 或
  // custom location）都在 proposal 创建时固化，查询绝不重新 join
  // MeetupPoint 生成历史地点
  locationTextSnapshot String
  // 来源 immutable provenance（RB01）：CUSTOM = 用户自定义地点（erasure 随
  // 作者注销 REDACT）；MEETUP_POINT = 平台 catalog 快照（erasure 保留，即使
  // meetupPointId 已被 ON DELETE SET NULL 置空）。创建后绝不回改。
  locationSource       OrderMeetupLocationSource
  scheduledAt          DateTime

  status       OrderMeetupStatus @default(PROPOSED)
  proposedById String
  proposedBy   User              @relation("OrderMeetupProposer", fields: [proposedById], references: [id], onDelete: Restrict)

  // counterparty 确认（CONFIRMED 唯一写路径；proposer 不得自确认）
  confirmedById String?
  confirmedBy   User?     @relation("OrderMeetupConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  confirmedAt   DateTime?

  // self-arrival attestation：买家只能写 buyerArrivedAt，卖家只能写
  // sellerArrivedAt（绝不接受 actor 指定 targetUserId）；双方齐 → COMPLETED
  buyerArrivedAt  DateTime?
  sellerArrivedAt DateTime?

  cancelledById String?
  cancelledBy   User?     @relation("OrderMeetupCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelledAt   DateTime?

  // no-show allegation provenance（reporter 已到场 + target 未到场为前提；
  // 与 OrderDispute 同事务创建，绝不单独构成判责）
  noShowReportedById String?
  noShowReportedBy   User?     @relation("OrderMeetupNoShowReporter", fields: [noShowReportedById], references: [id], onDelete: Restrict)
  noShowTargetId     String?
  noShowTarget       User?     @relation("OrderMeetupNoShowTarget", fields: [noShowTargetId], references: [id], onDelete: Restrict)
  noShowReportedAt   DateTime?

  // NO_SHOW_REPORTED → 本次产生的 canonical OrderDispute（nullable unique：
  // 手动 dispute 恒 null；证明 no-show 与 dispute 的 1:1 provenance）
  triggeredDisputeId String?       @unique
  triggeredDispute   OrderDispute? @relation("OrderMeetupTriggeredDispute", fields: [triggeredDisputeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, status])
  @@index([campusId, status])
}

model RentalReview {
  id                  String      @id @default(cuid())
  orderId             String
  order               RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId            String
  author              User        @relation("RentalReviewAuthor", fields: [authorId], references: [id])
  targetUserId        String
  targetUser          User        @relation("RentalReviewTarget", fields: [targetUserId], references: [id])
  // 租客评价维度
  itemMatchDesc       Int? // 物品符合描述 1-5
  itemWorksWell       Int? // 物品使用正常 1-5
  ownerResponsive     Int? // 出租者回复及时 1-5
  pickupEasy          Int? // 取还方便 1-5
  attitudeFriendly    Int? // 态度友好 1-5
  // 出租者评价维度
  returnedOnTime      Int? // 按时归还 1-5
  itemWellKept        Int? // 爱护物品 1-5
  accessoriesComplete Int? // 配件完整 1-5
  goodCommunication   Int? // 沟通顺畅 1-5
  reliable            Int? // 守约可靠 1-5
  // 综合
  overallRating       Int // 综合评分 1-5
  content             String?     @db.Text
  tags                String[]
  createdAt           DateTime    @default(now())
  // Phase 8E Review Integrity：与 Review 同款双盲发布 metadata（同一冻结语义）
  blindUntil          DateTime
  publishedAt         DateTime?

  @@unique([orderId, authorId])
  @@index([targetUserId, createdAt])
  @@index([orderId])
}

// Phase 7G：支持工单域（SupportTicket = support workflow truth；≠ Dispute）。
// - scope：用户创建时 campusId 省略 → UNSCOPED（campusId null + scopeKey
//   'UNSCOPED'）；提供 campusId 时 requester 必须持有该校区 ACTIVE membership，
//   然后 snapshot (campusId, 'CAMPUS:<id>')。禁止从 User.campusId 自动猜 scope
//   （DB CHECK 强制 exact pair / UNSCOPED 二选一）。
// - 字段分离冻结：resolutionMessage = USER_VISIBLE（requester 读面可返回）；
//   internalNote = OPERATOR_ONLY（任何 requester 读面结构性不返回）。
// - SLA：创建时 dueAt = createdAt + 72h；OVERDUE 只读判定 =
//   status IN (OPEN, IN_PROGRESS) ∧ dueAt < now；绝不自动 resolve/close/
//   escalate/enforce（Phase 9 才有 scheduled reminders）。
// - 终局（RESOLVED / CLOSED）不可 reopen；claim/release 不重置 dueAt。
// - 同一用户 active（OPEN/IN_PROGRESS）工单数上限 3 由服务层在
//   USER:requester 治理锁内强制（并发不得绕过）。
model SupportTicket {
  id          String @id @default(cuid())
  requesterId String
  requester   User   @relation("SupportTicketRequester", fields: [requesterId], references: [id])

  // scope 快照（immutable；UNSCOPED = null + 'UNSCOPED'）
  campusId String?
  campus   Campus? @relation("SupportTicketScopeCampus", fields: [campusId], references: [id], onDelete: Restrict)
  scopeKey String

  category    SupportTicketCategory
  status      SupportTicketStatus   @default(OPEN)
  subject     String
  description String                @db.Text

  // 运营领用（claim/release；SetNull：领用人引用消失时 ticket 仍在）
  assignedToId String?
  assignedTo   User?   @relation("SupportTicketAssignee", fields: [assignedToId], references: [id])

  // 处理 SLA：创建时 = createdAt + 72h（唯一运行时写路径）
  dueAt DateTime

  // 终局（RESOLVED / CLOSED）写入；terminal 不可 reopen
  resolutionCode    SupportResolutionCode?
  resolutionMessage String?                @db.Text // USER_VISIBLE
  internalNote      String?                @db.Text // OPERATOR_ONLY
  resolvedById      String? // 治理 provenance 裸字符串（无 FK）
  resolvedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 治理队列排序 keyset tuple（dueAt ASC, createdAt ASC, id ASC）
  @@index([dueAt, createdAt, id])
  // campus agent exact-pair 授权谓词
  @@index([campusId, scopeKey])
  @@index([assignedToId])
  // requester 侧 active 计数（创建上限 3 的锁内复查）
  @@index([requesterId, status])
}

// ============================================================
// Phase 5：法务协议 / 隐私治理模型
// ============================================================

// 版本化法务/平台政策文档。核心不变量：PUBLISHED 即不可变——
// type/version/content/contentHash/effectiveAt/requiresAcceptance 一经发布
// 不得原地修改，需要变更必须创建新版本（由 LegalDocumentService 强制）。
model LegalDocument {
  id                 String              @id @default(cuid())
  type               LegalDocumentType
  version            Int
  status             LegalDocumentStatus @default(DRAFT)
  title              String
  content            String              @db.Text
  // 对 canonical content（UTF-8 原文）的 SHA-256，hex 小写。
  // acceptance 证据必须能反查到确切 id/version/hash。
  contentHash        String
  effectiveAt        DateTime
  publishedAt        DateTime?
  requiresAcceptance Boolean             @default(true)
  createdById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  acceptances        PolicyAcceptance[]

  @@unique([type, version])
  @@index([type, status, effectiveAt])
}

// 同意证据（审计记录）：创建后不得改写为另一个 version/hash。
// @@unique([userId, documentId]) 保证幂等：并发双击不会产生重复证据。
model PolicyAcceptance {
  id              String                 @id @default(cuid())
  userId          String
  documentId      String
  // 发布文档不可变，这里仍冗余快照三元组：证据自身自足，不依赖联表还原。
  documentType    LegalDocumentType
  documentVersion Int
  documentHash    String
  source          PolicyAcceptanceSource
  acceptedAt      DateTime               @default(now())
  createdAt       DateTime               @default(now())
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  document        LegalDocument          @relation(fields: [documentId], references: [id])

  @@unique([userId, documentId])
  @@index([userId, acceptedAt])
  @@index([documentId])
}

// 隐私请求（数据导出 / 账号注销）。状态只能经显式 transition helper 流转，
// 禁止任意赋值跳状态。ACCOUNT_DELETION 的"同一用户至多一个 active 请求"
// 由迁移 SQL 中的部分唯一索引兜底。
model PrivacyRequest {
  id          String               @id @default(cuid())
  userId      String
  type        PrivacyRequestType
  status      PrivacyRequestStatus @default(REQUESTED)
  // BLOCKED/REJECTED 时的机器可读原因（如 ACTIVE_DATA_HOLD / ACTIVE_TRANSACTION_BLOCK）
  reasonCode  String?
  handledNote String?
  requestedAt DateTime             @default(now())
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Phase 9C-03：一个 DATA_EXPORT 请求至多一个 canonical 导出 artifact。
  artifact    DataExportArtifact?

  @@index([userId, type, status])
  @@index([status, requestedAt])
}

// Phase 9C-03：隐私数据导出 artifact（durable async export）。
// system-generated derived privacy artifact——绝不复用 UploadedAsset：
// 不参与 AssetCategory / 用户 storage quota / upload lifecycle。
// bucket/objectKey 是内部秘密（STORAGE_METADATA），绝不进入任何
// browser-visible surface（list DTO / download 响应 / 前端 props）。
// objectKey deterministic：requestId → exactly one object key（retry /
// ambiguous PUT 重放安全，见 data-export-contract.ts 注释）。
// artifact 不计入 User.storageUsedBytes（用户导出自身隐私数据绝不被
// 存储 quota 阻断）。
enum DataExportArtifactStatus {
  // 生成中：Step A（prepare）提交的 durable recovery anchor——在任何
  // S3 PUT 之前落库，保证 ambiguous PUT / crash 后对象 key 始终可追踪。
  WRITING
  // 可下载（request COMPLETED；expiresAt 起算点）。
  READY
  // 待物理删除（到期 / 注销 / 请求收敛失败）。cleanup 负责 DeleteObject。
  PENDING_DELETE
  // 对象已物理删除（S3 delete 幂等 + 条件转移 exactly-once）。
  DELETED
}

model DataExportArtifact {
  id        String                   @id @default(cuid())
  // 1:0..1 PrivacyRequest（requestId UNIQUE = canonical artifact 不变量）
  requestId String                   @unique
  userId    String
  status    DataExportArtifactStatus @default(WRITING)
  // 内部存储定位符（STORAGE_METADATA）：只存 DB 与 server storage 层，
  // 绝不出现在任何用户可见面
  bucket    String
  objectKey String                   @unique
  mimeType  String                   @default("application/json")
  sizeBytes Int                      @default(0)
  // 完整性摘要（READY 时写入；下载时复核，损坏不向用户返回）
  sha256    String?
  // 下载窗口截止（TTL 从 artifact READY / request COMPLETED 起算，
  // 绝不从 REQUESTED 起算——排队时间不得吞掉下载窗口）
  expiresAt DateTime?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  // 物理删除完成时间（status=DELETED 时写入；语义与 soft-delete 无关，
  // 不参与 prisma-soft-delete 拦截）
  deletedAt DateTime?

  // RB03：本行是 S3 external side-effect 的 durable recovery authority
  // （bucket/objectKey/status = 对象恢复元数据）——parent 物理删除绝不能
  // 静默 CASCADE 抹掉本行（否则 S3 PII 对象可能成为无主 orphan）。
  // Restrict：只要存在未收敛 artifact，PrivacyRequest / User 行物理删除
  // 一律被 DB 拒绝；收敛只能经 cleanup 状态机（PENDING_DELETE → DELETED
  // tombstone 保留）。
  request PrivacyRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  user    User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  // expiry / cleanup 扫描：READY 到期 → PENDING_DELETE；PENDING_DELETE → 物理删除
  @@index([status, expiresAt])
  @@index([status, updatedAt])
}

// 数据保留 / 纠纷冻结（Legal Hold / Dispute Hold）。
// ACTIVE hold 必须阻断破坏性擦除与保留期清理；hold 校验必须在破坏性事务
// 内部二次执行（防 TOCTOU）。创建/解除入口在 Phase 5 仅暴露 service seam
// （测试/seed 使用），管理界面属于 Phase 7。
model DataHold {
  id           String         @id @default(cuid())
  type         DataHoldType
  status       DataHoldStatus @default(ACTIVE)
  // 预留作用域（当前仅 USER_ACCOUNT），Phase 6/7 扩展时无需改表
  scope        String         @default("USER_ACCOUNT")
  subjectType  String         @default("USER")
  subjectId    String
  reasonCode   String
  // Phase 7G：source provenance（如 sourceType=RENTAL_DISPUTE + sourceId=
  // disputeId）。非空时同一 (type, subjectType, subjectId, source) 至多一个
  // ACTIVE 行（迁移 partial unique index 强制）；terminal release 按 source
  // 精确解除，绝不触碰无关 LEGAL hold。
  sourceType   String?
  sourceId     String?
  note         String?
  createdById  String?
  createdAt    DateTime       @default(now())
  releasedAt   DateTime?
  releasedById String?

  @@index([subjectType, subjectId, status])
  @@index([status, type, createdAt])
  // source-linked release / 重复防护查询
  @@index([sourceType, sourceId, status])
}

// ============================================================
// Phase 6A：身份 / 校园成员 / 认证策略 / RBAC 模型
// ============================================================

enum CampusMembershipStatus {
  // 已申请加入（6A 注册路径直接 ACTIVE，PENDING 为未来加入审批预留）
  PENDING
  ACTIVE
  REJECTED
  // 校园级停用（账号级停用仍在 User.status，二者独立判定，均须 ACTIVE 才放行）
  SUSPENDED
  LEFT
}

enum RoleScope {
  // 平台级角色：权限覆盖所有校区
  GLOBAL
  // 校园级角色：权限仅在 campusId 匹配的目标校区内生效
  CAMPUS
}

// 与 LegalDocument 同一版本化原则：PUBLISHED 即不可变
// （version/instructions/contentHash/effectiveAt 一经发布不得原地修改），
// 变更必须创建更高版本；current = PUBLISHED + effectiveAt<=now 中 version 最高。
enum CampusVerificationPolicyStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

// User ↔ Campus 的成员关系。membership 存在 != membership active；
// 一切 campus-scoped 操作必须经中央 resolver
// （src/lib/campus/membership-service.ts）解析 ACTIVE membership。
model CampusMembership {
  id            String                 @id @default(cuid())
  userId        String
  campusId      String
  status        CampusMembershipStatus @default(PENDING)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus        Campus                 @relation(fields: [campusId], references: [id])
  // 当前产品单 active campus：一个 membership 至多一条认证记录
  verifications UserVerification[]

  // membership 身份唯一性由数据库表达，不依赖 TypeScript if
  @@unique([userId, campusId])
  @@index([userId, status])
  @@index([campusId, status])
}

// 校园认证策略（per-campus 版本化）。创建/发布入口 6A 仅暴露 service seam
// （测试/seed 使用），管理界面属于 Phase 7，与 LegalDocument 同先例。
model CampusVerificationPolicy {
  id            String                         @id @default(cuid())
  campusId      String
  campus        Campus                         @relation(fields: [campusId], references: [id])
  version       Int
  status        CampusVerificationPolicyStatus @default(DRAFT)
  title         String
  // 展示给用户的认证要求说明；canonical content = 本字段 UTF-8 原文
  instructions  String                         @db.Text
  // 对 canonical content 的 SHA-256（hex 小写），认证证据反查用
  contentHash   String
  effectiveAt   DateTime
  publishedAt   DateTime?
  createdById   String?
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt
  verifications UserVerification[]

  @@unique([campusId, version])
  @@index([campusId, status, effectiveAt])
}

// 角色是 permission 的集合。业务授权依据是 permission，不是 role name：
// 禁止 `role.key === "PLATFORM_ADMIN"` 之类业务判断，一律走
// src/lib/rbac/service.ts 的 hasPermission / requirePermission。
model Role {
  id              String               @id @default(cuid())
  key             String               @unique
  name            String
  scope           RoleScope            @default(GLOBAL)
  // 系统内置角色不可删除；权限集合只能通过 bootstrap 幂等收敛
  isSystem        Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  rolePermissions RolePermission[]
  userRoles       UserRoleAssignment[]
}

// permission key 为稳定 machine-readable 标识（如 "verification.review"），
// 定义唯一来源：src/lib/rbac/permissions.ts。未知 permission 一律 DENY。
model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

// 角色授予。GLOBAL 角色行 campusId 为 null、scopeKey="GLOBAL"；
// CAMPUS 角色行 campusId 必填、scopeKey="CAMPUS:<campusId>"。
// scopeKey 兜底 Postgres 唯一约束不把 NULL 视为相等的问题，
// 与 campusId 的一致性由 assignment service 维护。
// 角色授予（命名注：与遗留 UserRole 枚举区分；遗留枚举仅为 User.role 展示字段服务）。
// GLOBAL 角色行 campusId 为 null、scopeKey="GLOBAL"；
// CAMPUS 角色行 campusId 必填、scopeKey="CAMPUS:<campusId>"。
// scopeKey 兜底 Postgres 唯一约束不把 NULL 视为相等的问题，
// 与 campusId 的一致性由 assignment service 维护。
model UserRoleAssignment {
  id           String   @id @default(cuid())
  userId       String
  roleId       String
  campusId     String?
  scopeKey     String
  assignedById String?
  assignedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  campus       Campus?  @relation(fields: [campusId], references: [id])

  @@unique([userId, roleId, scopeKey])
  @@index([userId])
  @@index([roleId])
}

// ============================================================
// Phase 6B：Trust / Risk State / Marketplace Restriction / Enforcement
// ============================================================

// 显式、可解释的风险状态。NORMAL/WATCH/RESTRICTED 与账号硬停用（User.status）
// 是不同概念：RESTRICTED 仅禁止"开始新的 marketplace 活动"，既有义务、
// 消息沟通、隐私操作不受影响（见 src/lib/enforcement/capability-gate.ts）。
// scope 语义：GLOBAL 行 campusId 为 null、scopeKey="GLOBAL"；
// CAMPUS 行 campusId 必填、scopeKey="CAMPUS:<campusId>"（同 UserRoleAssignment
// 的 nullable-unique 解法）。无行 = NORMAL（真实默认，不做任何推断式回填）。
enum RiskStateLevel {
  NORMAL
  WATCH
  RESTRICTED
}

// RiskState 是可变操作态 projection（更新必须持 USER subject 锁）；
// 历史溯源在 EnforcementAction / AdminLog，绝不在此表考古。
model RiskState {
  id          String         @id @default(cuid())
  userId      String
  campusId    String?
  scopeKey    String
  state       RiskStateLevel @default(NORMAL)
  // 最近一次变更的机器可读原因（enforcement reason code）
  reasonCode  String?
  updatedById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus      Campus?        @relation(fields: [campusId], references: [id])

  @@unique([userId, scopeKey])
  @@index([userId, state])
}

enum RiskFlagKind {
  // 未裁决举报信号（举报创建时记录；不是事实认定）
  REPORT_SUBMITTED
  // 经人工核查成立的举报（review RESOLVED 时记录）
  REPORT_CONFIRMED
  // 租赁纠纷开启
  RENTAL_DISPUTE_OPENED
  // 管理员手动标记（Phase 7 UI 提供，服务层 6B 先行）
  MANUAL_FLAG
}

enum RiskFlagSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
}

enum RiskFlagStatus {
  ACTIVE
  RESOLVED
}

// 风险信号（source-linked / deduplicated / resolvable）。
// 信号 != 裁决事实：REPORT_SUBMITTED 绝不自动产生任何处罚。
// (kind, sourceType, sourceId) 唯一 = 同一来源同一类信号至多一条。
model RiskFlag {
  id           String           @id @default(cuid())
  userId       String
  campusId     String?
  kind         RiskFlagKind
  severity     RiskFlagSeverity @default(INFO)
  sourceType   String
  sourceId     String
  reasonCode   String?
  note         String?
  status       RiskFlagStatus   @default(ACTIVE)
  createdById  String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus       Campus?          @relation(fields: [campusId], references: [id])

  @@unique([kind, sourceType, sourceId])
  @@index([userId, status])
  @@index([status, severity])
}

enum EnforcementActionType {
  MARKETPLACE_RESTRICT
  MARKETPLACE_RESTORE
  ACCOUNT_SUSPEND
  ACCOUNT_REINSTATE
  MEMBERSHIP_SUSPEND
  MEMBERSHIP_REINSTATE
}

// 处罚原因码（机器可读；自由文本 note 仅辅助说明）。
enum EnforcementReasonCode {
  FRAUD_CONFIRMED
  HARASSMENT_CONFIRMED
  ACCOUNT_SECURITY
  POLICY_VIOLATION
  MANUAL_REVIEW
  FALSE_POSITIVE_CORRECTION
  OTHER
  // Phase 6C-1B：Appeal GRANT 触发的恢复动作专用（与 AppealDecisionReasonCode
  // 是两个独立 taxonomy，禁止 cast/复用）。
  APPEAL_GRANTED
}

// 执法历史 / provenance（who/what/whom/where/why/when/source）。
// 这不是第二套 operational state：真实账号状态仍是 User.status，
// 成员状态仍是 CampusMembership.status，限制态仍是 RiskState——
// 本表只记录"谁在何时依据什么对谁做了什么"，append-only。
model EnforcementAction {
  id             String                @id @default(cuid())
  type           EnforcementActionType
  actorId        String
  targetId       String
  // campus-scoped 动作的目标校区（GLOBAL 动作为 null）
  campusId       String?
  scopeKey       String
  reasonCode     EnforcementReasonCode
  note           String?
  // 来源追溯（如 Report / RiskFlag / MANUAL）
  sourceType     String?
  sourceId       String?
  // 动作生效后的状态快照（如 "USER:SUSPENDED" / "CAMPUS_MEMBERSHIP:SUSPENDED" /
  // "RISK_STATE:RESTRICTED@CAMPUS:<id>"），仅作历史证据
  resultState    String
  // Phase 6C-1A：动作生效前的精确状态快照（与 resultState 同一编码）。
  // null = 迁移前 legacy 行或 rollback-image 写入（reversal provenance 不完整）；
  // 历史 before-state 不可可靠重建，禁止回填，禁止按 type/resultState 推断
  previousState  String?
  // Phase 6C-1A：post-migration enforcement epoch 的因果序（DB sequence 分配，
  // LEGACY_SEQ_BOUNDARY = 1_000_000_000 之前为 legacy epoch）。
  // createdAt / id 仅作展示与 wall-clock 审计用途，绝不是因果序
  enforcementSeq BigInt                @unique @default(autoincrement())
  createdAt      DateTime              @default(now())
  actor          User                  @relation("EnforcementActor", fields: [actorId], references: [id])
  target         User                  @relation("EnforcementTarget", fields: [targetId], references: [id])
  campus         Campus?               @relation(fields: [campusId], references: [id])
  // Phase 6C-1B：针对本执法动作的申诉（永久至多一条，enforcementActionId @unique）
  appeal         Appeal?

  @@index([targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([type, createdAt])
}

// ============================================================
// Phase 6C-1B：Appeal（申诉域，challenges EnforcementAction）
// ============================================================

// 申诉状态机：SUBMITTED → IN_REVIEW → { GRANTED | UPHELD | DISMISSED }；
// SUBMITTED → WITHDRAWN（appellant 主动撤回；IN_REVIEW 起不可撤回）；
// 四个 terminal 态不可变。允许 SUBMITTED → terminal（atomic claim + decision）。
// IN_REVIEW 仅是 workflow 状态（无 claimant/assignment 语义）：
// reviewedById / reviewedAt 只在 terminal decision 时写入实际决策者。
enum AppealStatus {
  SUBMITTED
  IN_REVIEW
  GRANTED
  UPHELD
  DISMISSED
  WITHDRAWN
}

// 申诉决定原因码。与 EnforcementReasonCode 是两个独立 taxonomy，禁止 cast/复用：
// - 四个程序性码仅可用于 DISMISSED（成功提交的 workflow 结局，不是异常）；
// - MERIT_APPEAL_JUSTIFIED 仅可用于 GRANTED；MERIT_VIOLATION_CONFIRMED 仅可用于 UPHELD；
// - WITHDRAWN 恒为 null。合法组合由 appeal review service 在锁内强制。
enum AppealDecisionReasonCode {
  STALE_ENFORCEMENT
  ENFORCEMENT_ALREADY_REVERSED
  LEGACY_PROVENANCE_INSUFFICIENT
  APPELLANT_ERASED
  MERIT_APPEAL_JUSTIFIED
  MERIT_VIOLATION_CONFIRMED
}

// 申诉（who challenges which enforcement decision）。
// - owner 唯一来源 = EnforcementAction.targetId（不冗余 appellantId），
//   仅 target 本人可提交/撤回；
// - 一个 EnforcementAction 永久至多一条 Appeal（enforcementActionId @unique，
//   WITHDRAWN/UPHELD/DISMISSED 也不释放槽位，禁止 delete + recreate 绕过）；
// - scope / target / type 全部从 immutable EnforcementAction 读取，不冗余列；
// - reviewedById nullable 只服务于非 terminal 状态：terminal provenance
//   不得因 reviewer 被删而清空 → 两个 FK 均显式 onDelete: Restrict
//   （optional relation 的 Prisma 默认是 SetNull，必须显式覆盖）；
// - decisionNote = 内部审核备注，唯一来源是本列（禁止进入审计/日志/导出）。
model Appeal {
  id                  String                    @id @default(cuid())
  enforcementActionId String                    @unique
  status              AppealStatus              @default(SUBMITTED)
  statement           String                    @db.Text
  // Phase 7G 审核 SLA：提交时 = createdAt（提交时刻）+ 48h（唯一运行时写路径；
  // 历史行由 migration backfill 以行自身 createdAt 为 origin，绝不用迁移执行
  // 时刻）。OVERDUE 只读判定 = status IN (SUBMITTED, IN_REVIEW) ∧ reviewDueAt
  // < now；SLA 不改变 Appeal state machine / enforcement reversal 语义。
  reviewDueAt         DateTime
  reviewedById        String?
  reviewedAt          DateTime?
  decisionReasonCode  AppealDecisionReasonCode?
  decisionNote        String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  enforcementAction EnforcementAction @relation(fields: [enforcementActionId], references: [id], onDelete: Restrict)
  reviewedBy        User?             @relation("AppealReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  // 队列排序 keyset tuple（reviewDueAt ASC, createdAt ASC, id ASC）
  @@index([reviewDueAt, createdAt, id])
}

// ============================================================
// Phase 7C：Listing Moderation Operations Surface（governance overlay）
// ============================================================

// 治理目标域（taxonomy 分立：与 ModerationTargetType / EnforcementActionType
// 是独立 taxonomy，禁止 cast/复用——6C-1B appeal 先例）。
enum ListingModerationTargetType {
  PRODUCT
  SERVICE
  ERRAND
  RENTAL
}

// 治理处置原因码（operator-facing 机器码；与 EnforcementReasonCode /
// ReportReason 分立，禁止跨域 cast）。
enum ListingModerationReasonCode {
  PROHIBITED_ITEM
  FRAUD_DECEPTION
  SPAM_ADVERTISEMENT
  CONTENT_VIOLATION
  OTHER
}

// listing 治理 overlay（OPTION B 冻结：业务 listing status 一律不变）。
// - 一次 takedown = 一行；restore = 原行 resolve（resolvedAt/resolvedById
//   回填）。活跃行（resolvedAt IS NULL）承载"隐藏中"语义；同一 listing
//   至多一个活跃行（四个 partial unique index，PostgreSQL 侧强制）。
// - resolved 历史 = 治理历史（同一 listing 的全部行），不因 resolve 消失，
//   不阻断未来再次 takedown。
// - observedStatus = takedown 时刻业务状态快照，仅历史证据；restore 绝不
//   以它回写业务 status。
// - note = moderator 内部备注（≤500）：不返回 owner、不入审计 metadata、
//   不入结构化日志（AdminAudit 仅以 moderationId 指针关联）。
// - 四个 typed target FK 镜像 Report 先例；type↔FK 配对一致性由 DB CHECK
//   （ListingModeration_target_consistency）强制；全部 FK 显式
//   onDelete: Restrict（governance provenance 不可随 referent 删除静默
//   消失；当前 soft-delete/erasure 契约不触发）。
model ListingModeration {
  id         String                      @id @default(cuid())
  targetType ListingModerationTargetType

  productId        String?
  serviceListingId String?
  errandTaskId     String?
  rentalListingId  String?
  product          Product?        @relation("ModerationTargetProduct", fields: [productId], references: [id], onDelete: Restrict)
  serviceListing   ServiceListing? @relation("ModerationTargetService", fields: [serviceListingId], references: [id], onDelete: Restrict)
  errandTask       ErrandTask?     @relation("ModerationTargetErrand", fields: [errandTaskId], references: [id], onDelete: Restrict)
  rentalListing    RentalListing?  @relation("ModerationTargetRental", fields: [rentalListingId], references: [id], onDelete: Restrict)

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)

  observedStatus String
  reasonCode     ListingModerationReasonCode
  note           String?

  moderatorId String
  moderator   User     @relation("ListingModerator", fields: [moderatorId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("ListingModerationResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([campusId, resolvedAt, createdAt])
  @@index([productId])
  @@index([serviceListingId])
  @@index([errandTaskId])
  @@index([rentalListingId])
}

// ============================================================
// Phase 9A — Async Core / Transactional Outbox
// ============================================================
// 永久原则：business transaction COMMIT ≠ external/async side effect
// completed。domain state 与 async intent（job / outbox event）必须在同一
// 数据库事务内原子落盘；durable queue authority = PostgreSQL（禁止
// Kafka / RabbitMQ / Redis durable queue / 新微服务）。
//
// AsyncJob（业务 job intent）与 OutboxEvent（domain event outbox）是两张
// 语义分离的表：job = "稍后必须执行的领域动作"；outbox = "已发生的事实，
// 需幂等派生副作用（通知/未来渠道）"。禁止合并成一张语义模糊的大表。
//
// 隐私契约（privacy-data-registry 同步登记）：payload 只允许 IDs + 机器
// 状态（如 { orderId }），禁止任何 user-authored 自由文本 / secret；
// leaseToken 是机器 fencing token（UUID），非用户数据。
// ============================================================

enum AsyncJobStatus {
  // 可被 claim（PENDING + RETRY 都是 runnable candidate；RETRY = 已失败
  // 且按 backoff 排程中）。绝不引入语义模糊的 FAILED——无法表达
  // "还会不会自动重试" 的状态一律禁止。
  PENDING
  RUNNING
  RETRY
  COMPLETED
  DEAD_LETTER
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PUBLISHED
  DEAD_LETTER
}

model AsyncJob {
  id            String @id @default(cuid())
  kind          String
  // job kind 不用 Prisma enum：新增 worker handler 不应每次都改
  // PostgreSQL enum。fail closed 由 runtime registry 保证——未知
  // kind / schemaVersion 直接 PERMANENT → DEAD_LETTER，禁止猜测执行。
  schemaVersion Int
  // 幂等 enqueue 唯一键（如 PRODUCT_RESERVATION_EXPIRE:<orderId>）；
  // createMany skipDuplicates 语义依赖此 UNIQUE 约束。
  dedupeKey     String @unique
  payload       Json

  status AsyncJobStatus @default(PENDING)
  runAt  DateTime

  // attempts = 实际 execution claim 次数（第一次 claim 0 → 1），
  // 不是 failure 次数——worker crash（lease 过期被回收）也计入 attempt。
  attempts    Int @default(0)
  maxAttempts Int @default(8)

  // lease 所有权：leaseOwner 仅是诊断 label（process-instance unique
  // workerId，可含 hostname）；真正 fencing authority = leaseToken
  // （每次 claim 重新生成；completion / failure 更新必须条件命中
  // status = RUNNING AND leaseToken = current，否则 0 rows = 被 fence）。
  leaseOwner     String?
  leaseToken     String?
  leaseExpiresAt DateTime?

  // 只存安全 error code + 截断（<=500）的 sanitized message；
  // 完整 stack 走结构化应用日志，绝不入库。
  lastErrorCode    String?
  lastErrorMessage String?

  completedAt    DateTime?
  deadLetteredAt DateTime?

  // Phase 9C-04：dedupe-safe terminal tombstone（§4/§5）。retention 对
  // COMPLETED 行执行 in-place payload compaction——状态保持 COMPLETED，
  // 绝不新增第二套终态状态机，绝不 DELETE 行（dedupeKey UNIQUE 是
  // exactly-once / replay suppression authority，删行 = 释放幂等身份，
  // stale replay 会重新 enqueue 同一意图 → duplicate side effect）。
  // tombstonedAt != null 的行永远不会再次 claim（claim candidate 只含
  // PENDING/RETRY/RUNNING），payload 收敛为固定机器 marker
  //（retention.ts TOMBSTONE marker，故意不符合任何 job payload schema）。
  // DEAD_LETTER 绝不是 retention candidate（未决运维事件，保留诊断面）。
  tombstonedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // claim candidate 扫描：(PENDING/RETRY, runAt <= now) 与 crash
  // recovery（RUNNING, leaseExpiresAt <= now）
  @@index([status, runAt, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([kind, status, runAt])
  // Phase 9C-04：retention candidate 扫描（COMPLETED, completedAt <= cutoff,
  // tombstonedAt IS NULL）——terminal anchor 是 completedAt（§21：排队/重试
  // 时间不得吞掉 terminal retention）
  @@index([status, completedAt, tombstonedAt])
}


// ============================================================
// Phase 10A — Authoritative Domain Fact Ledger
// ============================================================
//
// DomainEvent != OutboxEvent:
// - DomainEvent = 已发生领域事实的持久历史 authority，供 replay/backfill/
//   analytics projection 使用；不得被 retention tombstone。
// - OutboxEvent = 已发生事实等待派生副作用的 transport runtime，允许 terminal
//   payload compaction；绝不能反过来充当历史 event store。
//
// 10A 只建立 ledger + 写边界 + 一个真实纵向 writer；10B 才接 projection
// scheduling / AsyncJob / ProjectionReceipt，避免提前创建会被无意义消费的 job。
model DomainEvent {
  id            String   @id @default(cuid())
  eventType     String
  schemaVersion Int

  aggregateType String
  aggregateId   String

  // 事件发生时的 authoritative tenant snapshot。禁止从 request/client 输入
  // 直接透传；writer 必须从锁内/事务内 canonical domain row 获取。
  campusId String

  // 可选 provenance。不是关系 FK：ledger 必须能在账号 pseudonymous erasure
  // 后继续保留历史结构事实，不被用户行生命周期级联删除。
  actorUserId   String?
  subjectUserId String?

  // 语义 occurrence identity（跨 schema version 稳定）——同一事实只能存在一次。
  occurrenceKey String @unique

  // 只允许 registry strict schema 的 IDs + machine enums / bounded machine values；
  // 禁止 user-authored free text、secret、provider raw payload。
  payload Json

  // occurredAt = 领域事实发生时间；recordedAt = ledger 持久化时间。
  // 指标分桶必须使用 occurredAt，禁止用 worker/recordedAt 代替业务时间。
  occurredAt DateTime
  recordedAt DateTime @default(now())

  // provenance：10A live writer 固定 DOMAIN_TX；未来 backfill/reconciliation
  // 必须显式使用不同机器 sourceType，禁止伪装为实时 domain event。
  sourceType String @default("DOMAIN_TX")
  sourceId   String?

  projectionReceipts  ProjectionReceipt[]
  metricContributions MetricContribution[]

  @@index([eventType, occurredAt, id])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([campusId, occurredAt, id])
  @@index([recordedAt, id])
}


// ============================================================
// Phase 10B — Rebuildable Analytics Projection Foundation
// ============================================================
//
// ProjectionReceipt = projection correctness authority:
// (projectionKey, eventId, projectionVersion) 恰好一条，和派生 projection
// effect 在同一事务提交。AsyncJob 的 COMPLETED 不是 projection correctness
// authority；worker crash after tx commit 时 receipt 让重放成为 no-op。
model ProjectionReceipt {
  id                String   @id @default(cuid())
  projectionKey     String
  projectionVersion Int
  eventId           String
  event             DomainEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  projectedAt       DateTime @default(now())

  @@unique([projectionKey, eventId, projectionVersion])
  @@index([eventId, projectionKey, projectionVersion])
  @@index([projectionKey, projectionVersion, projectedAt], map: "ProjectionReceipt_projection_version_projected_idx")
}

// Event-level metric contribution：故意不在 10B 固化 campus-local day bucket。
// occurredAt 保留真实业务时间，10C+ 可按指标定义/业务时区聚合；本表完全
// derived + rebuildable，绝不能反向驱动订单状态、权限、RiskState 或 enforcement。
model MetricContribution {
  id                String   @id @default(cuid())
  projectionKey     String
  projectionVersion Int
  eventId           String
  event             DomainEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  metricKey     String
  metricVersion Int
  campusId      String
  occurredAt    DateTime
  dimensionKey  String
  value         Decimal  @db.Decimal(24, 6)

  createdAt DateTime @default(now())

  @@unique([projectionKey, projectionVersion, eventId, metricKey, metricVersion, dimensionKey], map: "MetricContribution_projection_event_metric_dim_key")
  @@index([metricKey, metricVersion, campusId, occurredAt], map: "MetricContribution_metric_campus_occurred_idx")
  @@index([eventId, projectionKey, projectionVersion])
}

model OutboxEvent {
  id            String @id @default(cuid())
  eventType     String
  schemaVersion Int
  aggregateType String
  aggregateId   String
  dedupeKey     String @unique

  payload Json

  status      OutboxEventStatus @default(PENDING)
  availableAt DateTime

  attempts    Int @default(0)
  maxAttempts Int @default(8)

  leaseOwner     String?
  leaseToken     String?
  leaseExpiresAt DateTime?

  lastErrorCode    String?
  lastErrorMessage String?

  publishedAt    DateTime?
  deadLetteredAt DateTime?

  // Phase 9C-04：dedupe-safe terminal tombstone（与 AsyncJob 同构，§8）。
  // PUBLISHED 行 retention 时 in-place compaction payload → 机器 marker，
  // 状态保持 PUBLISHED、dedupeKey UNIQUE 永不释放（replay suppression
  // authority）；tombstoned 行永远不会再次 dispatch（claim candidate 只含
  // PENDING/PROCESSING）。DEAD_LETTER 保留（未决运维事件）。
  tombstonedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([eventType, status, availableAt])
  // Phase 9C-04：retention candidate 扫描（PUBLISHED, publishedAt <= cutoff,
  // tombstonedAt IS NULL）——terminal anchor 是 publishedAt（§21）
  @@index([status, publishedAt, tombstonedAt])
}
