# 依赖与构建产物（镜像内重新安装/构建）
node_modules
.next
out
build

# 版本控制与 CI
.git
.github

# 本地环境与秘密 —— 绝不进镜像
.env
.env.*
!.env.example

# 测试、文档、工件
tests
coverage
playwright-report
test-results
docs
*.md
!README.md

# 编辑器与杂项
.vscode
.idea
.DS_Store
.mimosa
tsconfig.tsbuildinfo

# =============================================================================
# RB-06 FINAL-03：Docker build context 必须是 committed git tree 的确定性投影。
# 以下与 .gitignore 的本地/运行时产物对齐 —— git ignored 的文件不会出现在
# `git status --porcelain`（deploy STEP 0 的 clean tree 检查看不到它们），
# 但 COPY . 会把 build context 内的一切带入镜像；必须在 context 层排除。
# 静态 gate：tests/ops/docker-context-provenance.test.ts
# 动态 canary probe：tests/ops/docker-context-probe.Dockerfile
# =============================================================================

# 本地测试/工具运行时产物
.playwright-mcp
.tmp-test-uploads
tests/e2e/.auth
tests/e2e/.artifacts
tests/e2e/.report
tests/e2e/.run-state.json

# Vercel / 日志 / 证书 / 系统文件
.vercel
*.log
*.pem
*.stackdump

# Next.js / TS 本地产物（builder 阶段内由 next build 重新生成）
next-env.d.ts
*.tsbuildinfo

# 本地开发数据库
prisma/dev.db
prisma/dev.db-journal

# 仓库根的本地截图
/*.png

# 本地工具状态文件（未跟踪的本地 tool config）
.zcodeignore

# 运行时用户上传（legacy / local-only）：绝不进 immutable production image
# （部署主机遗留上传文件的 inventory/quarantine 属既有 operational debt）。
# tracked placeholder 资产通过 negation 保留进入 context：
public/uploads/*
!public/uploads/placeholders/
!public/uploads/placeholders/**

# #157 R1F: test-only Docker lease/crash probes are host bind mounts in CI.
# Do not bake privileged test seams or crash harness source into a runtime image.
scripts/ops/worker-lease-fencing-extension.sh
scripts/ops/worker-lease-fencing-proof.ts

# R1G: deterministic lock-barrier probes are host bind mounts only.
scripts/ops/worker-lock-contention-extension.sh
scripts/ops/worker-lock-contention-proof.ts

# #157 R2B: disposable host-only backup probe must never ship inside images.
scripts/ops/ops-runner-isolated-extension.sh
# R3A CLI experiment is CI-host-only and must never ship in release images.
scripts/ops/prisma7-cli-shadow-extension.sh
# R3B client/adapter probe is host-only, never a release artifact.
scripts/ops/prisma7-client-shadow-extension.sh
# R3C real extension and tenant predicate shadow proof stays CI-host-only.
scripts/ops/prisma7-extensions-shadow-extension.sh
# R3D-01 synthetic shadow probes must never ship in production images.
scripts/ops/prisma7-order-rental-tx-shadow-extension.sh
# R3D02A canonical writer experiment remains on the disposable CI host.
scripts/ops/prisma7-canonical-writer-shadow-extension.sh
scripts/ops/prisma7-canonical-writer-relocate.cjs.txt
scripts/ops/prisma7-canonical-writer-probe.ts.txt
# R3D02B01 original product expiry shadow-only AST/PG probes.
scripts/ops/prisma7-product-expiry-prepare.cjs.txt
scripts/ops/prisma7-product-expiry-probe.ts.txt
scripts/ops/prisma7-product-expiry-shadow-extension.sh

# R3D02B02 product actor proof: test-only disposable shadow inputs.
scripts/ops/prisma7-product-actor-prepare.cjs.txt
scripts/ops/prisma7-product-actor-probe.ts.txt
scripts/ops/prisma7-product-actor-shadow-extension.sh
