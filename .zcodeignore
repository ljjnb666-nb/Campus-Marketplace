# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
.next/
out/
build/

# Tests
coverage/
playwright-report/
test-results/
.playwright-mcp/
.tmp-test-uploads/

# Playwright E2E（运行时产物：storageState 含会话 cookie，严禁提交）
tests/e2e/.auth/
tests/e2e/.artifacts/
tests/e2e/.report/
tests/e2e/.run-state.json

# Environment variables
.env
.env.*
!.env.example
!.env.production.example
!.env.production.synthetic

# Logs
*.log
.codex-dev.log

# Vercel
.vercel/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# System files
.DS_Store
Thumbs.db
*.pem
*.stackdump

# Local databases
prisma/dev.db
prisma/dev.db-journal

# Dev screenshots at repo root
/*.png

# Runtime user uploads (keep bundled placeholder assets)
public/uploads/*
!public/uploads/placeholders/

# Local tool state
.mimosa/
.vscode/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
__pycache__/
site-packages/
venv/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
