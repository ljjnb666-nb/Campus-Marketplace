    "db:seed": "tsx prisma/seed.ts",
    "db:verify": "tsx prisma/verify-seed.ts",
    "app:smoke": "tsx scripts/verify-runtime.ts",
    "app:smoke:auth": "tsx scripts/verify-auth-runtime.ts",
    "text:verify": "tsx scripts/verify-text.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.540.0",
    "next": "16.2.10",
    "next-auth": "^4.24.14",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "sonner": "^2.0.7",
