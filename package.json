    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "26.1.0",
    "prisma": "6.19.3",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4",
    "tsx": "4.20.5",
    "typescript": "^5",
    "vitest": "3.2.4"
