DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus_marketplace?schema=public&connection_limit=10&pool_timeout=30&connect_timeout=10"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
APP_NAME="校园集市"
DEFAULT_CAMPUS_SLUG="main-campus"

# 限流计数存储（可选，多实例部署必须）：未配置时回退进程内计数（仅单实例有效）
# REDIS_URL="redis://localhost:6379"

# ============================================================
# S3 兼容对象存储（必需；默认值指向本地 docker compose 的 MinIO，
# 生产环境必须覆盖为真实服务并使用专属凭据，见 docs/STORAGE.md）
# ============================================================
S3_ENDPOINT="http://localhost:9100"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_PUBLIC="campus-public"
S3_BUCKET_PRIVATE="campus-private"
# MinIO 必须为 true；AWS S3 通常为 false；R2 建议为 true
S3_FORCE_PATH_STYLE="true"

# 公开对象访问基础 URL（bucket 级，可指向 CDN）
PUBLIC_ASSET_BASE_URL="http://localhost:9100/campus-public"

# 私有对象签名 URL 有效期（秒），默认 5 分钟
PRIVATE_SIGNED_URL_TTL_SECONDS="300"
# 每用户上传总配额（MB），默认 500
STORAGE_QUOTA_MB="500"
# 未绑定业务的临时上传保留时长（小时），超时由 npm run storage:cleanup 回收
ASSET_ORPHAN_TTL_HOURS="24"
# 认证材料在审核出结果后的保留天数，到期自动清理原图（认证结论保留）
VERIFICATION_ASSET_RETENTION_DAYS="30"
# Phase 9C-03：异步导出 artifact 的 worker 资源安全上限（字节）；
# 默认 32 MiB（schema 强制 >= 9 MiB，严格高于已退役的 8 MiB 同步响应保护）；
# 超限明确 REJECTED 不静默截断
DATA_EXPORT_ARTIFACT_MAX_BYTES="33554432"
# Phase 9C-03：导出文件下载窗口（小时），从生成完成起算，到期自动物理删除
DATA_EXPORT_ARTIFACT_TTL_HOURS="24"

# Phase 9C-04：Phase 9 retention 窗口（工程治理 baseline，非法律意见；
# 生产期限需正式 legal review）。terminal anchor：AsyncJob=completedAt /
# OutboxEvent=publishedAt / NotificationDelivery=providerAcceptedAt 或
# suppressedAt（绝非 createdAt）
ASYNC_TERMINAL_RETENTION_DAYS="30"
NOTIFICATION_DELIVERY_PII_RETENTION_DAYS="30"

# ---- Phase 9B: transactional email（本地开发默认 disabled = 0 provider call）----
EMAIL_PROVIDER=disabled
# RESEND_API_KEY=
# EMAIL_FROM=noreply@localhost
# EMAIL_REPLY_TO=
# EMAIL_PROVIDER_TIMEOUT_MS=10000

# Phase 10K-R2a: defaults OFF. Enable only after privacy/deployment review.
# Opt-in requires signed browser POST + completed server search. Metrics still UNAVAILABLE.
SEARCH_TELEMETRY_CAPTURE=

# 10K-R2b/R2c: never enable until all projection workers support new events.
ANALYTICS_CONVERSATION_EVENT_EMISSION=
ANALYTICS_FIRST_REPLY_EVENT_EMISSION=

# 10K-R2c-02A: OFF until all projection workers are upgraded and rollout approved.
# Dedicated signing key; never copy NEXTAUTH_SECRET or enable in production by default.
ANALYTICS_ORDER_ATTRIBUTION_EMISSION=
ANALYTICS_ORDER_ATTRIBUTION_SECRET=
