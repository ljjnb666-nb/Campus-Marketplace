# =============================================================================
# Campus Marketplace — production environment contract（模板）
#
# 用法：cp .env.production.example .env.production 后逐项填写真实值。
# .env.production 已被 .gitignore 忽略，绝不能提交到 Git。
# 校验：node 脚本 scripts/production-env-check.ts（tsx）只验证存在性/格式/
# 危险默认值，不输出任何秘密值。
# =============================================================================

# ---- Release identity（部署脚本注入，不手填）----
# GIT_SHA 由 scripts/ops/deploy.sh 以当前 HEAD 传入 compose build args
# SITE_ADDRESS：公网域名（Caddy ACME 自动 HTTPS），如 campus.example.edu.cn
SITE_ADDRESS=

# ---- 数据库（compose postgres 服务与 DATABASE_URL 必须一致）----
POSTGRES_USER=campus_app
# 强密码（>=24 字符，随机生成）；禁止 postgres/postgres
POSTGRES_PASSWORD=
POSTGRES_DB=campus_marketplace
# 应用连接串：容器网络内走服务名 postgres；从宿主机管理时用 127.0.0.1
# 生产必须带 connection_limit 与 pool_timeout（Prisma 连接池）
DATABASE_URL=postgresql://campus_app:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/campus_marketplace?schema=public&connection_limit=10&pool_timeout=10

# ---- Redis（仅限流计数，EPHEMERAL；compose requirepass 使用该值）----
REDIS_PASSWORD=
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379

# ---- Auth.js ----
# 公网 origin（与 Caddy 对外域名一致，含 https://）
NEXTAUTH_URL=
# >=32 字符随机串：openssl rand -base64 32；禁止复用 CI/E2E dummy 值
NEXTAUTH_SECRET=

# ---- 应用元信息 ----
APP_NAME=校园集市
DEFAULT_CAMPUS_SLUG=main-campus

# ---- 对象存储 ----
# 外部 S3 提供商：填真实 endpoint（https）与凭据，且不要启用 compose 的
# selfhosted-minio profile。自建 MinIO：S3_ENDPOINT 填 http://minio:9000，
# 并设置 MINIO_* 三项（下方）。
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=campus-public
S3_BUCKET_PRIVATE=campus-private
S3_FORCE_PATH_STYLE=true
# 公开对象的基础 URL（bucket 级）——这是浏览器访问 public object 的公网地址，
# 与 S3_ENDPOINT（应用后端访问对象存储的内部地址）是两个不同的东西，不得混用：
# - 外部 S3/CDN：填提供商/CDN 的 bucket 级公网 URL
# - 自建 MinIO（selfhosted-minio profile）：填 https://<域名>/assets
#   （Caddy 的 /assets/* 只读出口 → minio:9000/campus-public/*，见 deploy/Caddyfile）
PUBLIC_ASSET_BASE_URL=
# 私有对象签名 URL 有效期（秒），默认 300
PRIVATE_SIGNED_URL_TTL_SECONDS=300

# ---- 自建 MinIO 专用（外部 S3 时留空）----
MINIO_ENDPOINT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ---- 存储策略（可沿用默认）----
STORAGE_QUOTA_MB=500
ASSET_ORPHAN_TTL_HOURS=24
VERIFICATION_ASSET_RETENTION_DAYS=30

# ---- 安全开关（生产禁止开启，除非本机冒烟验证）----
# ALLOW_LOCAL_S3_IN_PRODUCTION 仅限本机生产模式冒烟，服务器上必须删除/留空
ALLOW_LOCAL_S3_IN_PRODUCTION=

# ---- 备份（scripts/ops/backup-postgres.sh）----
# 独立备份目录（必须在数据库磁盘之外的分区/挂载点）
BACKUP_DIR=/var/backups/campus-marketplace
# 可选：异地备份目标（S3 兼容，如 s3://bucket/prefix，需 AWS CLI 已配置）
BACKUP_OFFSITE_TARGET=
# 保留天数（本地）
BACKUP_RETENTION_DAYS=14
