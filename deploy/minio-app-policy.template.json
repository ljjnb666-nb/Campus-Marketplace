{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:GetObjectVersion"],
      "Resource": ["arn:aws:s3:::__PUBLIC_BUCKET__/*", "arn:aws:s3:::__PRIVATE_BUCKET__/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::__PUBLIC_BUCKET__", "arn:aws:s3:::__PRIVATE_BUCKET__"]
    }
  ]
}
